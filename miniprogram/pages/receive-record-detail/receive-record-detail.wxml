<!-- 收礼详情 -->
<view class="card">
  <view class="form-row"><text class="form-label">姓名</text><text class="form-val">{{contactName}}</text></view>
  <view class="form-row"><text class="form-label">类型</text><text class="form-val">{{type}}</text></view>
  <view class="form-row"><text class="form-label">日期</text><text class="form-val">{{date}}</text></view>
  <view class="form-row"><text class="form-label">金额</text><text class="form-val strong red">+{{amountText}}</text></view>
  <view class="form-row"><text class="form-label">备注</text><text class="form-val {{remark === '无' ? 'ph' : ''}}">{{remark}}</text></view>
</view>

<view class="wanglai-link" bindtap="goWanglai">查看往来记录＞＞＞</view>

<view style="height:130px"></view>
<view class="bottom-btns">
  <view class="btn-outline" bindtap="onDelete">删除</view>
  <view class="btn-primary btn-half" bindtap="goEdit">修改</view>
</view>

<!-- 统一删除弹窗 -->
<confirm-modal show="{{showDelModal}}" title="删除收礼记录" content="{{delContent}}"
  bind:confirm="onConfirmDel" bind:cancel="onCancelDel" />
