/* 收礼详情：沿用全局样式 */
.strong { font-weight: 600; }
.red { color: #F0575A; }
.wanglai-link {
  text-align: center;
  margin-top: 20px;
  color: #F0575A;
  font-size: 15px;
}
.bottom-btns {
  position: fixed;
  left: 24px;
  right: 24px;
  bottom: 26px;
  display: flex;
  gap: 12px;
}
.btn-outline {
  flex: 1;
  height: 56px;
  line-height: 54px;
  background: #fff;
  color: #F0575A;
  border: 1px solid #F0575A;
  text-align: center;
  font-size: 17px;
  border-radius: 28px;
}
.btn-half {
  flex: 1;
  position: static;
  left: auto;
  right: auto;
  bottom: auto;
}
