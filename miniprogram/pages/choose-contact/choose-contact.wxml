<!-- 选择亲友：小喇叭提示在搜索框上边 -->
<view class="tip" wx:if="{{!hornOff}}"><image class="tip-icon" src="/images/icons/speaker.svg" mode="aspectFit" /><view class="horn-marquee"><view wx:if="{{hornRun}}" class="horn-track run" style="animation-duration:{{hornDur}}s"><text class="tip-txt-nowrap horn-cell">{{tipText}}</text><text class="tip-txt-nowrap horn-cell">{{tipText}}</text></view><text wx:else class="tip-txt-ellipsis">{{tipText}}</text></view><text class="tip-close" catchtap="onHornClose">×</text></view>

<view class="searchbar">
  <view class="searchbox">
    <input placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput"
      placeholder-style="color:#C2C2C2" style="flex:1;font-size:14px" />
  </view>
  <text class="search-cancel" bindtap="onCancelSearch">取消</text>
</view>

<view class="card">
  <view class="contact-row" wx:for="{{contacts}}" wx:key="_id"
    data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onPick">
    <text class="nm">{{item.name}}</text>
    <text class="rmk" wx:if="{{item.remark}}">{{item.remark}}</text>
  </view>
  <view class="contact-row" wx:if="{{contacts.length === 0}}">
    <text class="ph">没有找到相关亲友</text>
  </view>
</view>

<view class="fab fab-low" bindtap="goAdd">＋</view>

<!-- 添加亲友半屏 -->
<contact-sheet show="{{addSheetOpen}}"
  bind:confirm="onAddConfirm" bind:cancel="onAddCancel" />
