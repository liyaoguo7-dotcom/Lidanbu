/* 首页（界面风格规范 v1） */
.retry-bar {
  margin: 10px 12px 0; padding: 9px 12px;
  background: #FDF3D7; color: #9A7B1E;
  font-size: 13px; border-radius: 8px; text-align: center;
}
.privacy-note {
  margin: 10px 12px 0; padding: 9px 12px;
  background: #F1E6D3; color: #8A6D3B;
  font-size: 12px; line-height: 1.7; border-radius: 8px;
}
.entry-row {
  display: flex;
  padding: 18px 8px 14px;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.entry-icon { width: 30px; height: 30px; }
.entry-name { font-size: 13px; margin-top: 6px; color: #555; }
.bigcards {
  display: flex;
  gap: 12px;
  padding: 0 12px;
}
.bigcard {
  flex: 1;
  height: 150px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26px;
  font-weight: 600;
}
.bigcard.gift {
  background: linear-gradient(135deg, #ff8a80, #F0575A);
  box-shadow: 0 4px 12px rgba(240,87,90,.3);
}
.bigcard.receive {
  background: linear-gradient(135deg, #ffcc80, #fb8c00);
  box-shadow: 0 4px 12px rgba(251,140,0,.3);
}
