/* 首页（界面风格规范 v1；2026-10-21 按用户反馈调整版式） */
.page-flex {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}
.flex-spacer { flex: 1; min-height: 24px; }
/* 任务V：小结+最近往来两块加入后，上方留白压到最小、大卡顺延到下半屏（不贴 Tab 栏） */
.spacer-top { flex: 0.12; }
.bottom-gap { height: 46px; }
/* 本月小结（任务V）：淡黄条，整数场景金额口径 */
.month-bar {
  margin: 0 12px;
  background: #FBF3D9;
  border-radius: 12px;
  padding: 10px 16px;
  font-size: 13px;
  color: #7A6A45;
  display: flex;
  align-items: center;
}
.month-label { font-weight: bold; color: #5C4E33; margin-right: 8px; }
.month-recv { color: #E05353; font-weight: 600; }
.month-give { color: #333; font-weight: 600; }
.month-dot { margin: 0 6px; color: #C9B98A; }
.month-empty { color: #9A8B62; }
/* 最近往来卡（任务V） */
.recent-card { padding: 4px 16px 6px; }
.recent-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0 4px;
}
.recent-title { font-size: 15px; font-weight: bold; }
.recent-all { font-size: 12px; color: #C2C2C2; }
.recent-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-top: 1px solid #F0F0F0;
}
.recent-name { font-size: 15px; color: #333; line-height: 1.35; }
.recent-sub { font-size: 12px; color: #999; margin-top: 2px; line-height: 1.35; }
.recent-amt { font-size: 15px; font-weight: 600; text-align: right; line-height: 1.35; }
.recent-amt.plus { color: #E05353; }
.recent-amt.minus { color: #333; }
.recent-date { font-size: 12px; color: #C2C2C2; margin-top: 2px; text-align: right; line-height: 1.35; }
.retry-bar {
  margin: 10px 12px 0; padding: 9px 12px;
  background: #FDF3D7; color: #9A7B1E;
  font-size: 13px; border-radius: 8px; text-align: center;
}
.privacy-note {
  margin: 10px 12px 0; padding: 9px 12px;
  background: #F1E6D3; color: #8A6D3B;
  font-size: 12px; line-height: 1.7; border-radius: 8px;
}
.entry-row {
  display: flex;
  padding: 18px 8px 16px;
  margin-top: 36px; /* 覆盖 .card 的 12px：金刚区再往下挪一点 */
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.entry-disc {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.disc-share { background: #E2EEFB; }
.disc-photo { background: #FDE8E8; }
.disc-invite { background: #FDEFCB; }
.disc-export { background: #E0F3E4; }
.entry-icon { width: 38px; height: 38px; }
.entry-name { font-size: 13px; margin-top: 7px; color: #555; }
.bigcards {
  display: flex;
  gap: 14px;
  padding: 0 44px;
}
.bigcard {
  flex: 1;
  height: 66px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 21px;
  font-weight: 600;
}
.bigcard.gift {
  background: linear-gradient(135deg, #FFC7C3, #F78C8F);
  box-shadow: 0 4px 12px rgba(240,87,90,.18);
}
.bigcard.receive {
  background: linear-gradient(135deg, #FFE4B8, #FDBE68);
  box-shadow: 0 4px 12px rgba(251,140,0,.18);
}
