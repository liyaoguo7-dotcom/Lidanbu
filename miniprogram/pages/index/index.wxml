<!-- 礼单簿 · 首页（阶段2 2A；2026-10-21 版式调整：大卡缩小变淡下移、金刚区下移+图标放大加彩色底衬） -->
<view class="page-flex">
  <view class="retry-bar" wx:if="{{initFailed}}" bindtap="onRetryInit">网络不太顺，点这里重试</view>
  <view class="tip"><image class="tip-icon" src="/images/icons/speaker.svg" mode="aspectFit" /><text style="margin-left:6px">{{tipText}}</text></view>

  <view class="privacy-note" wx:if="{{privacyDeclined && !privacyShow}}">你还没有同意隐私政策与用户协议，账本可以先慢慢看；同意后，拍照导入、换头像这些功能就能用啦。</view>

  <view class="card entry-row">
    <view class="entry" wx:for="{{entries}}" wx:key="id" data-id="{{item.id}}" bindtap="onEntry">
      <view class="entry-disc disc-{{item.id}}"><image class="entry-icon" src="{{item.icon}}" mode="aspectFit" /></view>
      <text class="entry-name">{{item.name}}</text>
    </view>
  </view>

  <view class="month-bar" wx:if="{{monthSummary}}">
    <text class="month-label songti">本月人情往来</text>
    <block wx:if="{{monthSummary.hasRecords}}">
      <text>收 <text class="month-recv">¥{{monthSummary.receiveText}}</text></text>
      <text class="month-dot">·</text>
      <text>送 <text class="month-give">¥{{monthSummary.giftText}}</text></text>
    </block>
    <text wx:else class="month-empty">本月还没有记录</text>
  </view>

  <view class="card recent-card" wx:if="{{recent.length}}">
    <view class="recent-head">
      <text class="recent-title songti">最近往来</text>
      <text class="recent-all" bindtap="goWanglai">查看全部 ></text>
    </view>
    <view class="recent-row" wx:for="{{recent}}" wx:key="targetUrl" data-url="{{item.targetUrl}}" bindtap="onRecentTap">
      <view class="recent-main">
        <view class="recent-name">{{item.contactName}}</view>
        <view class="recent-sub">{{item.tagName}}<text wx:if="{{item.eventName}}"> · {{item.eventName}}</text></view>
      </view>
      <view class="recent-side">
        <view class="recent-amt {{item.kind === 'receive' ? 'plus' : 'minus'}}">{{item.amountText}}</view>
        <view class="recent-date">{{item.dateText}}</view>
      </view>
    </view>
  </view>

  <view class="flex-spacer spacer-top"></view>

  <view class="bigcards">
    <view class="bigcard gift" bindtap="goGifts"><text class="songti">送礼</text></view>
    <view class="bigcard receive" bindtap="goReceive"><text class="songti">收礼</text></view>
  </view>
  <view class="flex-spacer"></view>
  <view class="bottom-gap"></view>
</view>

<privacy-modal show="{{privacyShow}}" bindagree="onPrivacyAgree" binddisagree="onPrivacyDisagree" bindprivacy="onPrivacyPolicy" bindagreement="onPrivacyAgreement" />
