/* 我的页（任务Q2 重排；任务AE：上下紧凑 + 全页字体统一为亲友录联系人姓名大小 16px） */
.avatar-img { border-radius: 50%; }
.avatar-initial {
  border-radius: 50%;
  background: #F1E6D3; color: #8A6D3B;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; font-weight: 600;
}
.profile-chev { margin-left: auto; }
.ph { color: #999; font-size: 16px; margin-right: 4px; }
.m-actions { display: flex; align-items: center; gap: 10px; }
/* BX批六色：卡内两按钮各一色（深字配淡底；非会员时的「开通会员」不在用户点的两处里，保持白底红字不动） */
.m-btn.ghost {
  background: #E0F3E4; color: #333;
  border: none;
}
.contact-btn {
  background: #fff; border: none; border-radius: 0;
  font-size: 16px; text-align: left;
  width: 100%; box-sizing: border-box; line-height: 1.4;
}
.contact-btn::after { border: none; }
.profile { padding: 12px 16px; display: flex; align-items: center; }
/* 2026-10-31 用户定：头像栏改首页收礼左边色 #FFE4B8 半透明淡黄，纯色不渐变（原 DG 橙黄渐变作废） */
.card.profile { background: rgba(255, 228, 184, 0.6); }
.avatar {
  width: 56px; height: 56px;
  flex: none; margin-right: 14px;
}
.uname { font-size: 17px; font-weight: 600; display: block; }
.usub { font-size: 16px; color: #666; margin-top: 4px; display: block; } /* DI批（用户 2026-10-30 定）：头像栏“会员”二字加深 #999→#666 */
.member-card {
  padding: 12px 16px;
  /* 2026-10-31 用户定：会员卡改首页送礼右边浓粉红 #F78C8F，纯色不渐变（原 DG 红渐变作废） */
  background: #F78C8F;
  border: none;
  display: flex; flex-direction: column;
}
/* 2026-10-31 陪伴方块：拍照导入淡粉 #FDE8E8，居中一行，小书本图标 20px，天数加粗 */
.companion-card { background: #FDE8E8; display: flex; align-items: center; justify-content: center; padding: 12px 16px; }
.companion-icon { width: 20px; height: 20px; flex: none; margin-right: 8px; }
.companion-text { font-size: 16px; color: #333; }
.companion-days { font-weight: 600; }
.m-title { color: #fff; font-size: 16px; font-weight: 600; }
.m-desc { color: rgba(255,255,255,.85); font-size: 16px; margin-top: 6px; line-height: 1.55; }
.m-btn {
  margin-top: 10px; align-self: flex-start;
  background: #fff; color: #F0575A;
  font-size: 16px; font-weight: 600;
  padding: 8px 22px; border-radius: 20px;
}
.m-badge {
  margin-top: 10px; align-self: flex-start;
  background: #E2EEFB; color: #333; border: none; /* CF批：会员有效改首页家庭共享蓝（与礼友栏对换） */
  font-size: 16px; padding: 6px 16px; border-radius: 16px;
}
.section-title { padding: 2px 12px 0; font-size: 16px; color: #999; }
.feat { display: flex; align-items: center; padding: 7px 16px; min-height: 50px; border-bottom: 1px solid #F0F0F0; }
.feat:last-child { border-bottom: none; }
.feat-icon { width: 32px; height: 32px; flex: none; margin-right: 8px; }
.feat-mid { display: flex; flex-direction: column; }
.feat-t { font-size: 16px; font-weight: 600; }
.feat-d { font-size: 16px; color: #C2C2C2; margin-top: 3px; }
.switch {
  width: 46px; height: 26px; border-radius: 13px;
  background: #DDD; position: relative; flex: none;
  transition: background .2s;
}
.switch.on { background: #F0575A; }
.switch .dot {
  width: 22px; height: 22px; border-radius: 50%;
  background: #fff; position: absolute; top: 2px; left: 2px;
  transition: left .2s;
}
.switch.on .dot { left: 22px; }
.footer { text-align: center; font-size: 16px; color: #C2C2C2; padding: 12px 0 6px; }
.badge {
  min-width: 18px; height: 18px; border-radius: 9px;
  background: #F0575A; color: #fff;
  font-size: 16px; line-height: 18px; text-align: center;
  padding: 0 5px; margin-right: 6px; flex: none;
  box-sizing: border-box;
}
/* 页面级覆盖（只作用本页）：卡间距收紧、功能行高收紧、行文字统一 16px */
.card { margin: 8px 12px; }
/* BV批：overflow 让斑马行底色贴合卡片圆角（tinted 行在单行卡里会铺满整卡），
   只作用本页，不动全局 .card（别处卡片可能有溢出元素）；与上条分开写，
   免得 AE 锚点断言（卡间距字符串）失效。 */
.card { overflow: hidden; }
/* CD批（用户定：从横置礼单本往下各行背景恢复纯白） */
.contact-btn.rowbg { background: #FFFFFF; }
.form-row.rowbg { background: #FFFFFF; }
.form-row { min-height: 50px; }
.form-val { font-size: 17px; }
.chev { font-size: 18px; } /* DG批（用户 2026-10-30 定）：本页所有行右边箭头统一 16→18px，保持一致 */

/* 「添加到我的小程序」引导条 + 教程层（AP批形态，AS批：主红底白字单行不折行） */
.addmp-bar {
  position: relative;
  margin: 10px 12px 0;
  background: #F0575A;
  color: #fff;
  border-radius: 8px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  font-size: 15px;
}
/* BA批：红幅顶边同色小三角，冲上指着胶囊（right 由 JS 按胶囊实测写入） */
.addmp-tri {
  position: absolute;
  top: -5px;
  width: 10px;
  height: 10px;
  background: #F0575A;
  border-radius: 2px;
  transform: rotate(45deg);
}
.addmp-text { flex: 1; white-space: nowrap; overflow: hidden; }
.addmp-arrow { font-size: 16px; padding-left: 6px; }
/* BA批教程层：顶部白片——三行带序号步骤＋深藏青「我的小程序」面板卡＋红胶囊按钮 */
.addmp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .5);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 60;
}
.addmp-sheet {
  width: 100%;
  background: #fff;
  padding: 18px 20px 22px;
  padding-top: calc(env(safe-area-inset-top) + 52px);
  box-sizing: border-box;
}
.addmp-step {
  display: flex;
  align-items: center;
  font-size: 15px;
  color: #333;
  line-height: 1.6;
  padding: 3px 0;
}
.addmp-step-no { font-weight: 600; margin-right: 6px; }
.addmp-dots { font-weight: 700; letter-spacing: 2px; margin-left: 4px; }
/* 第 2 步文字前的橙色四点小图标（2×2 橙圆点） */
.addmp-grid-icon {
  width: 15px;
  height: 15px;
  flex: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: space-between;
  margin-right: 6px;
}
.addmp-gdot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #FF8A00;
}
/* 深藏青面板卡：模拟微信「我的小程序」面板 */
.addmp-panel {
  margin-top: 16px;
  background: #2B2B3D;
  border-radius: 12px;
  padding: 14px 16px 16px;
}
.addmp-panel-title { font-size: 12px; color: #9A9AA8; }
.addmp-panel-item {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.addmp-panel-logo {
  width: 44px;
  height: 44px;
  border-radius: 10px;
}
.addmp-panel-name { font-size: 13px; color: #fff; margin-top: 6px; }
.addmp-btn {
  margin: 18px auto 0;
  width: 200px;
  background: #F0575A;
  color: #fff;
  text-align: center;
  height: 46px;
  line-height: 46px;
  border-radius: 23px;
  font-size: 16px;
}
