/* 意见反馈 */
.fb-box { padding: 14px 16px 8px; }
.fb-input {
  width: 100%; height: 150px;
  font-size: 15px; line-height: 1.6;
}
.fb-count { text-align: right; font-size: 12px; color: #C2C2C2; padding: 4px 0; }
.fb-imgs { display: flex; flex-wrap: wrap; padding: 14px 16px; }
.fb-thumb { position: relative; width: 76px; height: 76px; margin: 0 10px 10px 0; }
.fb-img { width: 76px; height: 76px; border-radius: 8px; }
/* 删除小叉：可见圆徽仍是 22px（::after 画在原位置），本体扩到 44px 透明可点区
   （2026-10-21 质量回归修复，可点区域 ≥44px）。 */
.fb-del {
  position: absolute; top: -19px; right: -19px;
  width: 44px; height: 44px;
  background: transparent; color: transparent; font-size: 0;
}
.fb-del::after {
  content: '×';
  position: absolute; top: 11px; right: 11px;
  width: 22px; height: 22px; border-radius: 50%;
  background: rgba(0,0,0,.55); color: #fff;
  font-size: 14px; line-height: 22px; text-align: center;
}
.fb-add {
  width: 76px; height: 76px; border-radius: 8px;
  border: 1px dashed #DDD; color: #C2C2C2;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.fb-plus { font-size: 24px; font-weight: 300; line-height: 1; }
.fb-add-t { font-size: 11px; margin-top: 4px; }
