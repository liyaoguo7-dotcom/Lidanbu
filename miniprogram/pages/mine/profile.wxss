/* 个人资料 */
.avatar-btn {
  display: flex; flex-direction: column; align-items: center;
  padding: 20px 16px; background: #fff; border: none; line-height: 1.4;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 72px; height: 72px; border-radius: 50%; }
.avatar-ph {
  width: 72px; height: 72px; border-radius: 50%;
  background: #F1E6D3; color: #8A6D3B;
  font-size: 14px; display: flex; align-items: center; justify-content: center;
}
.avatar-hint { font-size: 12px; color: #C2C2C2; margin-top: 8px; }
.count-hint { font-size: 11px; color: #C2C2C2; padding: 0 16px 10px 98px; line-height: 1.6; }
.save-btn { margin: 18px 24px 0; }
