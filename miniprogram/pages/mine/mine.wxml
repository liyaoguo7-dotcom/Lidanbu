<!-- 我的（任务Q2 重排：资料条 → 会员与积分卡 → 横置/导出 → 邀请分享 → 通知组 → 底部；BE批取消我的页家庭共享入口） -->
<!-- 待注销提示：冷静期内显示，去注销页可撤销（账号级提醒，置顶） -->
<!-- CO批：整页包一层，左右滑动切换 tab（我的页无单根容器，包层不带样式、不改布局；fixed 元素不受影响） -->
<view class="{{swipeAnim ? 'swipe-back' : ''}}" style="position: relative; left: {{swipeX}}px" bindtouchstart="onTabSwipeStart" bindtouchmove="onTabSwipeMove" bindtouchend="onTabSwipeEnd">
<view class="warn-banner" wx:if="{{cancelPending}}" bindtap="onLogout">
  你的账号已申请注销，将在 {{cancelPending.cancelAtText}} 执行（还剩 {{cancelPending.remainingDays}} 天）。点这里可以撤销 ›
</view>

<!-- 「添加到我的小程序」引导条（顶部红幅，主红底白字单行）：点开三步教程；
     AS批定版：每次进入我的页都显示，「我知道了」只关本次进入，无持久标记；
     BA批：红幅顶边同色小三角冲上指着胶囊（right 由胶囊实测中心算出），
     照竞品视频红幅无 ×（关闭走教程层「我知道了」） -->
<view class="addmp-bar" wx:if="{{addMpGuideShow}}">
  <view class="addmp-tri" style="right:{{addMpTriRight}}px"></view>
  <text class="addmp-text" bindtap="onOpenAddMpTutorial">点击[添加到我的小程序]，下次打开更快捷</text>
  <text class="addmp-arrow" bindtap="onOpenAddMpTutorial">＞</text>
</view>

<!-- ① 个人资料条 -->
<view class="card profile" bindtap="onProfile">
  <image wx:if="{{avatarUrl}}" class="avatar avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
  <!-- BG批：没设头像时用空白人头默认头像，不再拿显示名首字（原「微」字）顶 -->
  <image wx:else class="avatar avatar-img" src="/assets/avatar-default.png" mode="aspectFill" />
  <view>
    <text class="uname">{{displayName}}</text>
    <text class="usub">{{memberStateText}}</text>
  </view>
  <text class="chev profile-chev">›</text>
</view>

<!-- ② 会员与积分卡片 -->
<view class="card member-card" bindtap="onPurchase">
  <text class="m-title">会员与积分</text>
  <text class="m-desc">{{memberText}}</text>
  <text class="m-desc">积分余额：{{pointsBalance}} 分（不过期）</text>
  <view class="m-actions">
    <view class="m-btn" wx:if="{{!isMember}}">开通会员</view>
    <view class="m-badge" wx:if="{{isMember}}">会员有效</view>
    <view class="m-btn ghost" catchtap="onPoints">我的积分</view>
  </view>
</view>

<!-- ②b 陪伴方块（2026-10-31 用户定）：会员卡片下、横置上面；淡粉底＋小书本图标＋“人情礼单簿已陪伴你 X 天” -->
<view class="card companion-card">
  <image class="companion-icon" src="/images/icons/mine-companion.png" mode="aspectFit" />
  <text class="companion-text">人情礼单簿已陪伴你<text class="companion-days" wx:if="{{companionDays}}"> {{companionDays}} 天</text></text>
</view>

<!-- ③ 横置礼单本（家庭共享与导出备份入口只在首页，BE批用户决定：我的页不再重复） -->
<view class="card">
  <view class="form-row rowbg" bindtap="onLandscapeToggle">
    <image class="row-icon" src="/images/icons/mine-landscape.png" mode="aspectFit" />
    <text class="form-val">横置礼单本</text>
    <view class="switch {{landscapeOn ? 'on' : ''}}"><view class="dot"></view></view>
  </view>
</view>

<!-- ④ 邀请分享（唯一入口） -->
<view class="card">
  <!-- BX批：斑马交替取消，会员卡下各行统一淡色块 -->
  <view class="form-row rowbg" bindtap="onInviteReward" style="{{inviteRewardEnabled ? '' : 'opacity:.45'}}">
    <image class="row-icon" src="/images/icons/mine-invite.png" mode="aspectFit" />
    <text class="form-val">邀请分享</text>
    <text class="ph" wx:if="{{inviteRewardEnabled}}">已邀请 {{inviteDone}}/{{inviteMax}}</text>
    <text class="chev">›</text>
  </view>
</view>

<!-- 演示专用行：只有本地演示模式才有，正式版不显示 -->
<view class="card" wx:if="{{demoMode}}">
  <view class="form-row rowbg" bindtap="onDemoMembership">
    <text class="form-val">演示：切换会员状态</text>
    <text class="chev">{{demoStateText}} ›</text>
  </view>
</view>

<!-- ⑤ 通知 / 意见反馈 / 常见问题 / 关于我们 / 联系客服 -->
<view class="card">
  <view class="form-row rowbg" bindtap="onNotifications">
    <image class="row-icon" src="/images/icons/mine-notify.png" mode="aspectFit" />
    <text class="form-val">通知</text>
    <view class="badge" wx:if="{{unreadCount}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
    <text class="chev">›</text>
  </view>
  <view class="form-row rowbg" bindtap="onFeedback">
    <image class="row-icon" src="/images/icons/mine-feedback.png" mode="aspectFit" />
    <text class="form-val">意见反馈</text><text class="chev">›</text>
  </view>
  <view class="form-row rowbg" bindtap="onFaq">
    <image class="row-icon" src="/images/icons/mine-faq.png" mode="aspectFit" />
    <text class="form-val">常见问题</text><text class="chev">›</text>
  </view>
  <view class="form-row rowbg" bindtap="onAbout">
    <image class="row-icon" src="/images/icons/mine-about.png" mode="aspectFit" />
    <text class="form-val">关于我们</text><text class="chev">›</text>
  </view>
  <button class="form-row contact-btn rowbg" open-type="contact">
    <image class="row-icon" src="/images/icons/mine-contact.png" mode="aspectFit" />
    <text class="form-val">联系客服</text><text class="chev">›</text>
  </button>
</view>

<!-- ⑥ 底部：隐私政策｜注销账号 + 版本号 -->
<view class="footer">
  <text bindtap="onPrivacy">隐私政策</text><text>｜</text><text bindtap="onLogout">注销账号</text>
</view>
<!-- 老板平台开发期隐藏入口：连点版本号 5 次进入。生产部署方式待定（上线前必须加管理员身份校验+二次验证）。 -->
<view style="text-align:center;padding:6px 0 4px" bindtap="onVersionTap">
  <text style="font-size:16px;color:#D8D8D8">{{version}}</text>
</view>
<view style="height:30px"></view>

<!-- 「添加到我的小程序」教程层（BA批按竞品视频排版）：页面上方三行带序号
     步骤（第 1 步后跟 ···、第 2 步文字前放橙色四点小图标）；步骤下深藏青
     圆角卡模拟微信「我的小程序」面板（我们的 logo＋名称）；卡下居中红
     色胶囊按钮「我知道了」，只关本次 -->
<view class="addmp-mask" wx:if="{{addMpTutorialShow}}">
  <view class="addmp-sheet">
    <view class="addmp-step"><text class="addmp-step-no">1.</text><text>点击屏幕右上角三个点</text><text class="addmp-dots">···</text></view>
    <view class="addmp-step"><text class="addmp-step-no">2.</text><view class="addmp-grid-icon"><view class="addmp-gdot"></view><view class="addmp-gdot"></view><view class="addmp-gdot"></view><view class="addmp-gdot"></view></view><text>点击 「添加到我的小程序」</text></view>
    <view class="addmp-step"><text class="addmp-step-no">3.</text><text>在微信首页往下拉，快速打开人情礼单簿</text></view>
    <view class="addmp-panel">
      <text class="addmp-panel-title">我的小程序</text>
      <view class="addmp-panel-item">
        <image class="addmp-panel-logo" src="/images/logo.png" mode="aspectFill" />
        <text class="addmp-panel-name">人情礼单簿</text>
      </view>
    </view>
    <view class="addmp-btn" bindtap="onAddMpKnow">我知道了</view>
  </view>
</view>
</view>
