<!-- 我的 -->
<view class="card profile">
  <image class="avatar" src="/images/icons/user.svg" mode="aspectFit" />
  <view>
    <text class="uname songti">我</text>
    <text class="usub">礼单簿 · 本地演示版</text>
  </view>
</view>

<view class="card member-card" bindtap="onMemberCard">
  <text class="m-title songti">会员卡片</text>
  <text class="m-desc">{{memberText}}</text>
  <text class="m-desc">积分余额：{{pointsBalance}} 分（不过期）</text>
  <view class="m-btn" wx:if="{{!isMember}}">开通会员</view>
  <view class="m-badge" wx:if="{{isMember}}">会员有效</view>
</view>

<view class="card">
  <view class="form-row" bindtap="onPoints">
    <text class="form-val">我的积分</text>
    <text class="ph">{{pointsBalance}} 分</text>
    <text class="chev">›</text>
  </view>
</view>

<view class="section-title">会员专属功能</view>
<view class="card">
  <view class="feat" wx:for="{{feats}}" wx:key="title">
    <image class="feat-icon" src="{{item.icon}}" mode="aspectFit" />
    <view class="feat-mid">
      <text class="feat-t songti">{{item.title}}</text>
      <text class="feat-d">{{item.desc}}</text>
    </view>
  </view>
</view>

<view class="card">
  <view class="form-row" bindtap="onLandscapeToggle">
    <text class="form-val">经典红字大写横置礼簿模式</text>
    <view class="switch {{landscapeOn ? 'on' : ''}}"><view class="dot"></view></view>
  </view>
</view>

<!-- 演示专用行：只有本地演示模式才有，正式版不显示 -->
<view class="card" wx:if="{{demoMode}}">
  <view class="form-row" bindtap="onDemoMembership">
    <text class="form-val">演示：切换会员状态</text>
    <text class="chev">{{demoStateText}} ›</text>
  </view>
</view>

<view class="card">
  <view class="form-row" bindtap="onInviteReward" style="{{inviteRewardEnabled ? '' : 'opacity:.45'}}">
    <text class="form-val">邀请好友得名额</text>
    <text class="chev">›</text>
  </view>
</view>

<!-- 待注销提示：冷静期内显示，去注销页可撤销 -->
<view class="warn-banner" wx:if="{{cancelPending}}" bindtap="onLogout">
  你的账号已申请注销，将在 {{cancelPending.cancelAtText}} 执行（还剩 {{cancelPending.remainingDays}} 天）。点这里可以撤销 ›
</view>

<view class="card">
  <view class="form-row" bindtap="onNotifications">
    <text class="form-val">通知</text>
    <view class="badge" wx:if="{{unreadCount}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
    <text class="chev">›</text>
  </view>
  <view class="form-row" bindtap="onFeedback">
    <text class="form-val">意见反馈</text><text class="chev">›</text>
  </view>
  <view class="form-row" bindtap="onFaq">
    <text class="form-val">常见问题</text><text class="chev">›</text>
  </view>
  <view class="form-row" bindtap="onAbout">
    <text class="form-val">关于我们</text><text class="chev">›</text>
  </view>
</view>

<view class="card">
  <view class="form-row" bindtap="onService">
    <text class="form-val">联系客服</text><text class="chev">›</text>
  </view>
  <view class="form-row" bindtap="onShare">
    <text class="form-val">分享转发</text><text class="chev">›</text>
  </view>
</view>

<view class="footer">
  <text bindtap="onPrivacy">隐私政策</text><text>｜</text><text bindtap="onLogout">注销账号</text>
</view>
<!-- 老板平台开发期隐藏入口：连点版本号 5 次进入。生产部署方式待定（上线前必须加管理员身份校验+二次验证）。 -->
<view style="text-align:center;padding:6px 0 4px" bindtap="onVersionTap">
  <text style="font-size:11px;color:#D8D8D8">{{version}}</text>
</view>
<view style="height:30px"></view>
