/* 积分页专属样式 */
.points-head { text-align: center; padding: 22px 12px; }
.ph-label { color: #999; font-size: 13px; }
.ph-main { margin: 6px 0; }
.ph-num { font-size: 40px; font-weight: 700; color: #F0575A; }
.ph-unit { font-size: 15px; color: #666; margin-left: 6px; }
.ph-rule { display: block; color: #999; font-size: 12px; line-height: 1.7; }
.led-mid { flex: 1; display: flex; flex-direction: column; }
.led-sub { color: #C2C2C2; font-size: 11px; margin-top: 2px; }
.led-delta { font-size: 16px; font-weight: 600; margin-left: 10px; }
.led-delta.plus { color: #3d9d4e; }
.led-delta.minus { color: #F0575A; }
