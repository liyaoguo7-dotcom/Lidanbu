/* 礼单簿 · 横置礼单本共用样式（收礼/送礼共用；页面 wxss 用 @import 引入）
   尺寸数字不在这里写死：关键尺寸由 JS 按 landscape-core 定版常量等比换算后内联注入。 */

/* ===== 字体声明：已删除（2026-10-23 任务AC 第 8 项）=====
   原任务Z 第 7 项在此写了三条指向分包 /packages/fonts/*.woff2 的 font-face 声明，
   但微信官方《分包加载》文档 Known BUG 明确："Currently Android can't load
   the font file under the subpackage"——Android 真机根本加载不了，是死代码；
   且与 font-manager 的 loadFontFace 机制重复。三款字体一律经
   services/font-source.js 候选链加载：用户数据区缓存 → 云存储（cloud-file，
   CLOUD_FONT_BASE 填入后启用） → 分包兜底。此处不要再加 font-face 声明。 */

/* ===== 请横屏（竖屏态，与定版图 30 一致） ===== */
.rotate-wrap {
  min-height: 100vh; background: #F7F3EC; display: flex; flex-direction: column;
  align-items: center; box-sizing: border-box;
}
.rotate-topbar {
  width: 100%; height: 132rpx; background: #F0E6D4; display: flex; align-items: center;
  padding: 0 24rpx; box-sizing: border-box;
}
/* 返回箭头：约 30px 字号、88rpx(≥44px) 可点区，在标题行内视觉居中，不贴屏幕角（2026-10-22 用户真机反馈：原 44rpx 太小太靠角） */
.rotate-back {
  font-size: 60rpx; color: #333; width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; flex: none;
}
.rotate-back-ph { width: 88rpx; }
.rotate-title {
  flex: 1; text-align: center; font-size: 34rpx; color: #333;
}
.rotate-center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 64rpx; }
.rotate-icon { width: 180rpx; height: 180rpx; margin-bottom: 40rpx; }
.rotate-main {
  font-size: 38rpx; color: #333; text-align: center; line-height: 1.5;
}
.rotate-sub { margin-top: 28rpx; font-size: 26rpx; color: #999; text-align: center; }
.rotate-lock { margin-top: 12rpx; font-size: 26rpx; color: #999; text-align: center; }
.rotate-btn {
  margin-bottom: 96rpx; padding: 22rpx 72rpx; border: 1px solid #C9BBA3; border-radius: 999rpx;
  color: #8A7A5F; font-size: 30rpx; background: transparent;
}

/* ===== 横屏礼单本 ===== */
.frame {
  height: 100vh; width: 100vw; box-sizing: border-box;
  display: flex; flex-direction: column; background-repeat: repeat;
}
.topbar { display: flex; align-items: center; position: relative; flex-shrink: 0; }
.back { font-size: 30px; color: #333; padding: 0 10px; line-height: 1; z-index: 2; }
.tgrp { position: absolute; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; }
.tpill {
  display: flex; align-items: center; background: rgba(255,255,255,0.55);
  border-radius: 999px; padding: 4px 16px;
}
.ticon { width: 18px; height: 18px; margin-right: 6px; }
.tname {
  font-size: 17px; color: #2B2B2B;
}
.tdate { font-size: 13px; color: #8A8175; margin-left: 4px; }
.style-btn {
  margin-left: auto; z-index: 2; font-size: 17px; color: #F0575A; font-weight: 600;
  background: rgba(255,255,255,0.55); border-radius: 999px; padding: 4px 12px;
  transform: translateY(6px);
  /* 2026-10-22 任务Z 第 6 项：字号 13→17、改红字、整体下移 6px；
     margin-right 由页面按微信胶囊实测位置内联注入（避让胶囊，WXML style 属性，
     任务Y 基础上再左移 10px 的量在 book-common 的偏移常量里） */
}
.midrow { flex: 1; display: flex; flex-direction: row; align-items: stretch; min-height: 0; }
.scroll-img { height: 100%; flex-shrink: 0; }
.scroll-img.flip { transform: scaleX(-1); }
.paper {
  flex: 1; position: relative; border: 2px solid; box-sizing: border-box;
  background-repeat: repeat; overflow: hidden;
}
.corner { position: absolute; width: 14px; height: 14px; border: 0 solid; z-index: 3; pointer-events: none; }
.corner.tl { top: 3px; left: 3px; border-top-width: 2px; border-left-width: 2px; }
.corner.tr { top: 3px; right: 3px; border-top-width: 2px; border-right-width: 2px; }
.corner.bl { bottom: 3px; left: 3px; border-bottom-width: 2px; border-left-width: 2px; }
.corner.br { bottom: 3px; right: 3px; border-bottom-width: 2px; border-right-width: 2px; }
.cols-scroll { width: 100%; height: 100%; }
.cols-track { display: flex; flex-direction: row; height: 100%; }
.col {
  flex-shrink: 0; height: 100%; box-sizing: border-box;
  border-left: 2px solid; position: relative; /* 列竖线 2px（任务AF真机反馈：竖线加粗一点，与纸面边框同重） */
}
.zone { position: absolute; left: 0; right: 0; }
/* 中段区钉在列高正中（任务AA）：区中心与列中心重合，区内字再居中 → 墨迹中心＝列中心 */
.zone-mid { top: 50%; transform: translateY(-50%); }
.vchar {
  position: absolute; left: 50%; transform: translateX(-50%);
  line-height: 1; white-space: nowrap;
}
.botbar { display: flex; align-items: center; flex-shrink: 0; position: relative; }
.hint { margin-left: 10px; }
.hint-txt {
  font-size: 11px; color: #8A8175; background: rgba(255,255,255,0.55);
  border-radius: 999px; padding: 3px 10px;
}
.plus-touch {
  margin-left: auto; margin-right: 8px; display: flex; align-items: center; justify-content: center;
}
.plus-circle {
  border-radius: 50%; color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 20px; line-height: 1; opacity: 0.85;
}

/* ===== 半屏（详情 / 样式面板） ===== */
.sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35); z-index: 50; display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #FFFDF8; border-radius: 14px 14px 0 0;
  padding: 14px 20px 20px; box-sizing: border-box; max-height: 86vh; overflow-y: auto;
}
.sheet-row { display: flex; padding: 6px 0; border-bottom: 1px solid #F0EDE6; }
.sheet-k { width: 56px; color: #999; font-size: 14px; flex-shrink: 0; }
.sheet-v { color: #333; font-size: 14px; }
.sheet-btns { display: flex; gap: 10px; margin-top: 14px; }
.sheet-btn {
  flex: 1; text-align: center; padding: 10px 0; border-radius: 999px; font-size: 14px;
}
.sheet-btn.ghost { border: 1px solid #D8CFBE; color: #6B5D4F; }
.sheet-btn.danger { background: #F0575A; color: #fff; }
.panel-title { font-size: 14px; color: #6B5D4F; margin: 8px 0; }
.opt-row { display: flex; gap: 10px; }
.opt-row.wrap { flex-wrap: wrap; }
.opt {
  flex: 1; border: 1px solid #E7E0D2; border-radius: 10px; padding: 8px 6px;
  display: flex; flex-direction: column; align-items: center; box-sizing: border-box;
}
.opt.sm { flex: 0 0 30%; }
.opt-sel { border-color: #C9A24B; background: rgba(201,162,75,0.08); }
.font-preview { font-size: 15px; color: #333; white-space: nowrap; }
.opt-name { font-size: 12px; color: #8A8175; margin-top: 6px; }
.swatch {
  width: 44px; height: 30px; border: 1px solid; border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
}
.swatch-paper { width: 26px; height: 18px; border-radius: 2px; }
.credit { margin-top: 14px; font-size: 11px; color: #B4A98F; text-align: center; }
