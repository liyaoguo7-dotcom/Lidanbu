<!-- 会员与积分：顶部状态 + 会员套餐（小方块） + 积分礼包（小方块），数字全部由配置渲染 -->
<view class="card member-card">
  <text class="m-title">{{stateText}}</text>
  <text class="m-desc" wx:if="{{expireText}}">会员到期日：{{expireText}}</text>
  <view class="points-row" bindtap="onPoints">
    <text class="points-label">积分余额</text>
    <text class="points-val num">{{pointsBalance}} 分</text>
    <text class="chev light">›</text>
  </view>
</view>

<view class="warn-banner" wx:if="{{!buyEnabled && platformDisabledTip}}">{{platformDisabledTip}}</view>
<view class="warn-banner" wx:if="{{doneText}}">{{doneText}}</view>
<view class="section-title" id="plans-section">会员套餐</view>
<!-- 套餐小方块（任务Z 第 4 项）：两列网格、点按选中、底部统一购买；
     「推荐」角标在方块顶边外侧，不遮挡金额 -->
<view class="block-grid" wx:if="{{plans.length}}">
  <view class="plan-block {{selectedPlanId === item.id ? 'sel' : ''}}"
        wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectPlan">
    <view class="badge-hot" wx:if="{{item.recommended}}">推荐</view>
    <text class="plan-name">{{item.name}}</text>
    <text class="plan-price num">¥{{item.priceText}}</text>
    <text class="plan-sub">{{item.days}} 天 · 赠 {{item.grantPoints}} 积分</text>
  </view>
</view>
<view class="tip" wx:if="{{!plans.length}}">会员套餐即将公布，敬请期待。</view>
<view class="btn-primary buy-btn" wx:if="{{hydrated && buyEnabled && plans.length}}" bindtap="onBuyPlan">{{buyingPlan ? '处理中…' : '购买所选套餐'}}</view>
<!-- CX批（用户 2026-10-29 定）：会员权益文案删去末尾一句 -->
<view class="tip">会员权益：横置礼单本（6 种样式 · 6 种字体）· 拍照录入 · 家庭共享邀请</view>
<!-- 2026-10-31 用户定：云端保存标语，放购买页会员权益下面 -->
<view class="tip">数据云端保存，安全可靠，随时可下载</view>

<view class="section-title">积分礼包</view>
<!-- 积分礼包小方块：金棕色系与会员方块（红米系）区分；非会员整区置灰 -->
<view class="{{packsLocked ? 'locked' : ''}}">
  <view class="block-grid" wx:if="{{packs.length}}">
    <view class="pack-block {{selectedPackId === item.id ? 'sel' : ''}}"
          wx:for="{{packs}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectPack">
      <text class="pack-name">{{item.name}}</text>
      <text class="pack-price num">¥{{item.priceText}}</text>
      <text class="pack-sub">{{item.points}} 积分</text>
    </view>
  </view>
  <view class="tip" wx:if="{{!packs.length}}">积分礼包即将上架，敬请期待。</view>
  <view class="tip" wx:if="{{packsLocked}}">先开通会员才能买积分包哦</view>
  <view class="tip" wx:if="{{!packsLocked}}">拍照录入每次用 {{photoImportCost}} 积分，积分不过期</view>
</view>
<view class="btn-primary buy-btn gold" wx:if="{{hydrated && buyEnabled && !packsLocked && packs.length}}" bindtap="onBuyPack">{{buyingPack ? '处理中…' : '购买所选礼包'}}</view>
<!-- 2026-10-31 用户定：无隐形收费、不自动续费标语，放购买页（即支付页）购买按钮下面，付款前可见 -->
<view class="tip">无隐形收费，到期不自动续费</view>

<view class="card">
  <view class="form-row" bindtap="onOrders">
    <text class="form-label">我的订单</text>
    <text class="form-val ph">查看购买记录与状态</text>
    <text class="chev">›</text>
  </view>
  <view class="form-row" bindtap="onPoints">
    <text class="form-label">我的积分</text>
    <text class="form-val ph">余额与每一笔流水</text>
    <text class="chev">›</text>
  </view>
</view>

<!-- 2026-10-31 用户定：退款文案只放购买页最下边，一行小字半透明；顶部和付款前弹窗均去掉，价格那句取消 -->
<view class="refund-foot" wx:if="{{refundNotice}}">{{refundNotice}}</view>
