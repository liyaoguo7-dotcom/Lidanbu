/* 老板平台通用样式（只看数字，不读账本内容） */
.stat-grid { display: flex; flex-wrap: wrap; padding: 4px; }
.stat-card {
  flex: 1 1 40%;
  background: #FFFFFF;
  border-radius: 12px;
  margin: 8px;
  padding: 18px 12px;
  text-align: center;
}
.stat-num { font-size: 26px; font-weight: bold; color: #333333; }
.stat-label { font-size: 13px; color: #999999; margin-top: 6px; }
.note { font-size: 13px; color: #999999; margin: 12px 16px; line-height: 1.6; }
.warn-banner {
  background: #FFF7E6;
  border: 1px solid #F5DFA8;
  color: #8A6D1B;
  font-size: 14px;
  border-radius: 12px;
  margin: 12px;
  padding: 14px 16px;
  line-height: 1.6;
}
.mask { font-family: monospace; font-size: 13px; color: #666666; }
.row-between { display: flex; justify-content: space-between; align-items: center; }
.pill {
  display: inline-block;
  font-size: 12px;
  border: 1px solid #E0E0E0;
  border-radius: 14px;
  padding: 4px 12px;
  margin: 4px 6px 4px 0;
  color: #666666;
}
.pill.on { border-color: #E05353; color: #E05353; font-weight: bold; }
.mini-btn {
  display: inline-block;
  font-size: 13px;
  color: #E05353;
  border: 1px solid #E05353;
  border-radius: 16px;
  padding: 6px 16px;
}
.input-line {
  background: #FFFFFF;
  border-radius: 12px;
  margin: 12px;
  padding: 0 16px;
  min-height: 58px;
  display: flex;
  align-items: center;
}
.input-line input { flex: 1; height: 58px; font-size: 15px; }
.iron { font-size: 13px; color: #B0492F; margin: 12px 16px; line-height: 1.6; }
.btn-danger-sm { display: inline-block; margin-left: auto; padding: 2px 14px; font-size: 13px; line-height: 1.9; color: #F0575A; background: #fff; border: 1px solid #F0575A; border-radius: 16px; }
