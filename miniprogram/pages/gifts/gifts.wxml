<!-- 送礼记录列表 -->
<view class="searchbar">
  <view class="searchbox">
    <input placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput"
      placeholder-style="color:#C2C2C2" style="flex:1;font-size:14px" />
  </view>
  <text class="search-cancel" bindtap="onCancelSearch">取消</text>
</view>

<view class="card entry-row" wx:if="{{showLandscapeEntry && !searching}}" bindtap="goLandscape">
  <text class="entry-title">横置礼单本</text>
  <text class="entry-arrow">></text>
</view>

<!-- 共计与记录合并为一张卡（任务AE 第 8 项复刻定版图）：共计居中大字、数字红字；
     共计↔记录、记录↔记录之间无灰底间隔、只有细线；列表末尾「完」 -->
<view class="card list-card" wx:if="{{shown.length > 0 || !searching}}">
  <view class="total-line" wx:if="{{!searching}}">
    <text>共计：</text><text class="red num">{{totalCount}}</text><text>笔 ¥</text><text class="red num">{{totalAmountText}}</text><text>元</text>
  </view>
  <!-- BX批：斑马交替取消，送礼记录行统一淡色块（行本身无底色，全局 .rowbg 直接生效） -->
  <view class="gift-row rowbg {{index === shown.length - 1 ? 'last' : ''}}" wx:for="{{shown}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
    <view class="pat"><image class="pat-img" src="{{item.icon}}" mode="aspectFit" /></view>
    <view class="mid">
      <text class="nm">{{item.name}}</text>
      <view class="subline"><text class="sub">{{item.tagName}}｜</text><text class="sub num">{{item.date}}</text></view>
    </view>
    <text class="amt num"><text class="sign">-</text>{{item.amountText}}</text>
  </view>
  <view class="list-end" wx:if="{{shown.length > 0 && !searching}}">
    <view class="end-line"></view><text class="end-text">完</text><view class="end-line"></view>
  </view>
</view>

<view class="empty" wx:if="{{shown.length === 0 && !searching}}">
  <image class="empty-icon" src="/images/icons/folder.svg" mode="aspectFit" />
  <text class="empty-text">还没有记录，请点击下方红色＋按钮添加</text>
  <text class="empty-slogan">今年你送出去了多少礼？</text>
  <text class="empty-sample" bindtap="goSample">点击查看示例</text>
</view>

<view class="empty" wx:if="{{shown.length === 0 && searching}}">
  <text class="empty-text">没有找到"{{keyword}}"相关记录</text>
</view>

<view class="fab" bindtap="goAdd">＋</view>

<!-- 底部自定义 Tab 栏（任务Z 第 1 项）：占位避免内容被栏遮挡，本页不高亮任何一项 -->
<view class="tabbar-spacer"></view>
<tab-bar selected="{{-1}}"></tab-bar>
