/* 送礼记录列表 */
.entry-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; }
.entry-title { font-size: 15px; font-weight: 600; }
.entry-arrow { color: #C2C2C2; font-size: 16px; }
.summary { padding: 14px 16px; font-size: 14px; }
.summary .red { color: #F0575A; font-weight: 600; }
.gift-row {
  display: flex;
  align-items: center;
  padding: 6px 16px;
  min-height: 56px;
  border-bottom: 1px solid #F0F0F0;
}
.gift-row:last-child { border-bottom: none; }
.pat {
  width: 44px; height: 44px; border-radius: 50%;
  background: #F5F6F4;
  display: flex; align-items: center; justify-content: center;
  flex: none;
}
.pat-img { width: 30px; height: 30px; }
.mid { flex: 1; margin-left: 12px; display: flex; flex-direction: column; }
.nm { font-size: 16px; font-weight: 600; }
.sub { font-size: 12px; color: #C2C2C2; margin-top: 3px; }
.amt { font-size: 16px; font-weight: 600; }
.empty { text-align: center; padding-top: 90px; display: flex; flex-direction: column; align-items: center; }
.empty-icon { width: 72px; height: 72px; opacity: .45; }
.empty-text { color: #C2C2C2; font-size: 14px; margin-top: 18px; }
.empty-sample { color: #F0575A; font-size: 14px; margin-top: 14px; }

/* 自定义 Tab 栏占位（任务Z 第 1 项）：栏高 + 安全区 + 余量（任务AC 第 2 项后栏总高 56px+安全区，58 仍够用） */
.tabbar-spacer { height: 58px; height: calc(58px + env(safe-area-inset-bottom)); }

/* 顶部三行贴紧（2026-10-23 任务AC 第 3 项）：搜索行、横置礼单本入口行、共计行之间的
   纵向留白归零——搜索行下内边距 10→0、入口行上下外边距 10→0、共计行上外边距 10→0；
   三行本身高度与内部排版一律不动（.card 的全局 margin 只在本页用复合选择器覆盖，不动全局）。 */
.searchbar { padding-bottom: 0; }
.card.entry-row { margin-top: 0; margin-bottom: 0; }
.card.summary { margin-top: 0; }
