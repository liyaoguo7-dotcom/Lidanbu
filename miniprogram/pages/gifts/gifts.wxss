/* 送礼记录列表 */
.entry-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; }
.entry-title { font-size: 15px; font-weight: 600; }
.entry-arrow { color: #C2C2C2; font-size: 16px; }
.total-line { text-align: center; font-size: 20px; padding: 14px 16px 12px; color: #333; border-bottom: 1px solid #F0F0F0; }
.total-line .red { color: #F0575A; font-weight: 600; }
.list-end { display: flex; align-items: center; gap: 10px; padding: 10px 60px 12px; border-top: 1px solid #F0F0F0; }
.end-line { flex: 1; height: 1px; background: #F0F0F0; }
.end-text { font-size: 12px; color: #C2C2C2; }
.gift-row {
  display: flex;
  align-items: center;
  height: 76px;
  box-sizing: border-box;
  padding: 6px 16px;
  position: relative;
}
.gift-row::after {
  content: ''; position: absolute; left: 84px; right: 0; bottom: 0;
  height: 1px; background: #F0F0F0;
}
.gift-row.last::after { display: none; }
.pat {
  width: 56px; height: 56px; border-radius: 50%;
  background: #F1E6D3;
  display: flex; align-items: center; justify-content: center;
  flex: none;
}
.pat-img { width: 40px; height: 40px; }
.mid { flex: 1; margin-left: 12px; display: flex; flex-direction: column; }
.nm { font-size: 16px; font-weight: 600; }
.subline { display: flex; flex-direction: row; align-items: baseline; margin-top: 3px; }
.sub { font-size: 13px; color: #999; }
.amt { font-size: 17px; font-weight: 600; }
.empty { text-align: center; padding-top: 90px; display: flex; flex-direction: column; align-items: center; }
.empty-icon { width: 72px; height: 72px; opacity: .45; }
.empty-text { color: #C2C2C2; font-size: 14px; margin-top: 18px; }
.empty-sample { color: #F0575A; font-size: 14px; margin-top: 14px; }

/* 自定义 Tab 栏占位（任务Z 第 1 项）：栏高 + 安全区 + 余量（任务AC 第 2 项后栏总高 56px+安全区，58 仍够用） */
.tabbar-spacer { height: 58px; height: calc(58px + env(safe-area-inset-bottom)); }

/* 顶部三行贴紧（2026-10-23 任务AC 第 3 项）：搜索行、横置礼单本入口行、共计行之间的
   纵向留白归零——搜索行下内边距 10→0、入口行上下外边距 10→0、共计行上外边距 10→0；
   三行本身高度与内部排版一律不动（.card 的全局 margin 只在本页用复合选择器覆盖，不动全局）。 */
.searchbar { padding-bottom: 0; }
.card.entry-row { margin-top: 0; margin-bottom: 0; }
.card.list-card { margin-top: 0; }
