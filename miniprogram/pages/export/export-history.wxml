<!-- 导出历史记录 -->
<view class="card" wx:if="{{jobs.length}}">
  <view class="form-row" wx:for="{{jobs}}" wx:key="_id">
    <view class="form-val">
      <text>{{item.scope}}</text>
      <view style="font-size:12px;color:#999;margin-top:4px">{{item.time}}</view>
    </view>
  </view>
</view>
<view class="tip" wx:if="{{!jobs.length}}">还没有导出记录。</view>
