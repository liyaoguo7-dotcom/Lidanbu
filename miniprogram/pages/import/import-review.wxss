.photo-row {
  display: flex;
  align-items: center;
  padding: 12px 16px;
}
.photo-thumb {
  width: 64px;
  height: 64px;
  border-radius: 8px;
  background: #F0F0F0;
  flex: none;
}
.photo-meta {
  flex: 1;
  margin-left: 12px;
  display: flex;
  flex-direction: column;
}
.photo-title { font-size: 15px; }
.photo-sub { font-size: 12px; color: #999; margin-top: 4px; }
.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px 0;
}
.item-no { font-size: 13px; color: #999; }
.item-del { font-size: 13px; color: #F0575A; padding: 6px 0 6px 12px; }
.unknown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 16px;
  background: #FFF7F0;
}
.unknown-hint { font-size: 13px; color: #E05353; }
.unknown-btn {
  font-size: 13px;
  color: #fff;
  background: #F0575A;
  border-radius: 14px;
  padding: 5px 14px;
}
.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4px 12px 12px;
  padding: 14px;
  background: #fff;
  border-radius: 12px;
  color: #F0575A;
  font-size: 15px;
}
.add-plus { font-size: 20px; margin-right: 6px; }
