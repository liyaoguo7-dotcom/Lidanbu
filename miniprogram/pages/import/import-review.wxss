.photo-row {
  display: flex;
  align-items: center;
  padding: 12px 16px;
}
.photo-thumb {
  width: 64px;
  height: 64px;
  border-radius: 8px;
  background: #F0F0F0;
  flex: none;
}
.photo-meta {
  flex: 1;
  margin-left: 12px;
  display: flex;
  flex-direction: column;
}
.photo-title { font-size: 15px; }
.photo-sub { font-size: 12px; color: #999; margin-top: 4px; }
/* AS批 紧凑化：记录卡连成一片连续白底（卡间距取消、只留细分割线，
   页面灰底在列表区不露面）；首/尾卡保留外侧圆角；表单行 58px→46px */
.item-card {
  margin: 0 12px;
  border-radius: 0;
  border-bottom: 1px solid #F0F0F0;
}
.item-card.item-first { margin-top: 10px; border-radius: 12px 12px 0 0; }
.item-card.item-last { border-radius: 0 0 12px 12px; border-bottom: none; margin-bottom: 10px; }
.item-card.item-first.item-last { border-radius: 12px; }
.item-card .form-row { min-height: 46px; }
.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px 0;
}
.item-no { font-size: 13px; color: #999; }
.item-del { font-size: 13px; color: #F0575A; padding: 4px 0 4px 12px; }
.unknown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 16px;
  background: #FFF7F0;
}
.unknown-hint { font-size: 13px; color: #E05353; }
.unknown-btn {
  font-size: 13px;
  color: #fff;
  background: #F0575A;
  border-radius: 14px;
  padding: 5px 14px;
}
.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 12px 12px;
  padding: 14px;
  background: #fff;
  border-radius: 12px;
  color: #F0575A;
  font-size: 15px;
}
.add-plus { font-size: 20px; margin-right: 6px; }

/* 原图固定在上方（滚动条目时始终可见） */
.photo-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
}
/* 校验失败定位到的条目 */
.item-error {
  border: 1.5px solid #F0575A;
}
.item-err {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #F0575A;
}
.pick-btn {
  flex: none;
  font-size: 13px;
  color: #F0575A;
  border: 1px solid #F0575A;
  border-radius: 14px;
  padding: 5px 12px;
  margin-left: 8px;
}
.form-picker { flex: 1; }
.form-picker .chev { color: #C2C2C2; }
/* 结果页 */
.result-card {
  margin-top: 60px;
  padding: 36px 24px 28px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-big { font-size: 20px; }
.result-count { font-size: 16px; margin-top: 14px; }
.result-sub { font-size: 13px; color: #999; margin-top: 8px; }
.result-btn { width: 100%; margin-top: 18px; text-align: center; }
/* 亲友选择器 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}
.picker-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding: 16px 16px 26px;
  padding-bottom: calc(26px + env(safe-area-inset-bottom));
  max-height: 72vh;
  display: flex;
  flex-direction: column;
}
.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-title { font-size: 16px; }
.picker-close { font-size: 22px; color: #999; padding: 0 6px; }
.picker-search { margin-top: 12px; }
.picker-list { margin-top: 8px; max-height: 38vh; }
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 2px;
  border-bottom: 1px solid #F0F0F0;
}
.picker-name { font-size: 15px; }
.picker-remark { font-size: 12px; color: #C2C2C2; }
.picker-empty { text-align: center; color: #C2C2C2; font-size: 13px; padding: 18px 0; }
.picker-new { margin-top: 14px; text-align: center; }
