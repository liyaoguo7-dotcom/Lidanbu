.photo-row {
  display: flex;
  align-items: center;
  padding: 12px 16px;
}
.photo-thumb {
  width: 64px;
  height: 64px;
  border-radius: 8px;
  background: #F0F0F0;
  flex: none;
}
.photo-meta {
  flex: 1;
  margin-left: 12px;
  display: flex;
  flex-direction: column;
}
.photo-title { font-size: 15px; }
.photo-sub { font-size: 12px; color: #999; margin-top: 4px; }
/* AS批 紧凑化：记录卡连成一片连续白底（卡间距取消、只留细分割线，
   页面灰底在列表区不露面）；首/尾卡保留外侧圆角；表单行 58px→46px。
   BA批：记录之间的分隔改口——线换成略明确的浅灰 #E8E8E8 1px，且线上下
   各多留约 10px 空白（本卡底部 padding 10px＋下一条头部 padding 加高），
   记录内部行线仍走全局发丝线不动 */
.item-card {
  margin: 0 12px;
  border-radius: 0;
  border-bottom: 1px solid #E8E8E8;
  padding-bottom: 10px;
}
.item-card.item-first { margin-top: 10px; border-radius: 12px 12px 0 0; }
.item-card.item-first .item-head { border-radius: 12px 12px 0 0; }
.item-card.item-last { border-radius: 0 0 12px 12px; border-bottom: none; margin-bottom: 10px; }
.item-card.item-first.item-last { border-radius: 12px; }
.item-card .form-row { min-height: 46px; }
/* BX批：核对页姓名字段大一号（本页姓名输入无独立字号，继承页面 15px，单加一档到 16px；金额／类型共用 .form-val 不动） */
.name-val { font-size: 16px; }
.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* BA再补（用户 2026-10-27 追加）：每条第一行带一条浅米色带（与标题栏
     #F0E6D4 同族的更浅一号 #FAF3E3，不违和），记录之间一眼可分；
     配合卡底 #E8E8E8 分隔线＋留白（原 18px 顶距由色带 10px 上下距替代） */
  background: #FAF3E3;
  padding: 10px 16px;
}
.item-no { font-size: 13px; color: #999; }
.item-del { font-size: 13px; color: #F0575A; padding: 4px 0 4px 12px; }
.unknown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 16px;
  background: #FFF7F0;
}
.unknown-hint { font-size: 13px; color: #E05353; }
.unknown-btn {
  font-size: 13px;
  color: #fff;
  background: #F0575A;
  border-radius: 14px;
  padding: 5px 14px;
}
.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 12px 12px;
  padding: 14px;
  background: #fff;
  border-radius: 12px;
  color: #F0575A;
  font-size: 15px;
}
.add-plus { font-size: 20px; margin-right: 6px; }

/* 原图固定在上方（滚动条目时始终可见） */
.photo-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
}
/* 校验失败定位到的条目 */
.item-error {
  border: 1.5px solid #F0575A;
}
.item-err {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #F0575A;
}
.pick-btn {
  flex: none;
  font-size: 13px;
  color: #F0575A;
  border: 1px solid #F0575A;
  border-radius: 14px;
  padding: 5px 12px;
  margin-left: 8px;
}
.form-picker { flex: 1; }
.form-picker .chev { color: #C2C2C2; }
/* BA批：底部确认栏——容器白底不透明＋顶边发丝线，按钮本体纯主红实心，
   滚动内容不得透出（只在本页覆盖，不动全局 .btn-primary） */
.review-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top: 1px solid #F0F0F0;
  padding: 12px 0;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  z-index: 30;
}
.review-bar .review-confirm {
  background: #F0575A;
  opacity: 1;
}
/* 结果页 */
.result-card {
  margin-top: 60px;
  padding: 36px 24px 28px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-big { font-size: 20px; }
.result-count { font-size: 16px; margin-top: 14px; }
.result-sub { font-size: 13px; color: #999; margin-top: 8px; }
.result-btn { width: 100%; margin-top: 18px; text-align: center; }
/* 亲友选择器 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}
.picker-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding: 16px 16px 26px;
  padding-bottom: calc(26px + env(safe-area-inset-bottom));
  max-height: 72vh;
  display: flex;
  flex-direction: column;
}
.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-title { font-size: 16px; }
.picker-close { font-size: 22px; color: #999; padding: 0 6px; }
.picker-search { margin-top: 12px; }
.picker-list { margin-top: 8px; max-height: 38vh; }
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 2px;
  border-bottom: 1px solid #F0F0F0;
}
.picker-name { font-size: 15px; }
.picker-remark { font-size: 12px; color: #C2C2C2; }
.picker-empty { text-align: center; color: #C2C2C2; font-size: 13px; padding: 18px 0; }
.picker-new { margin-top: 14px; text-align: center; }

/* DF批：场合／类型平铺格子（每排 5 个；选中红框红字＋淡粉底；确定红字取消灰字） */
.tile-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.tile-cell { width: calc(20% - 7px); box-sizing: border-box; text-align: center; font-size: 15px; color: #333; border: 1px solid #E8E8E8; border-radius: 8px; padding: 11px 0; }
.tile-cell.on { border-color: #F0575A; color: #F0575A; background: #FDE8E8; }
.tile-btns { display: flex; margin-top: 16px; border-top: 1px solid #F0F0F0; }
.tile-btn { flex: 1; text-align: center; padding: 13px 0; font-size: 16px; }
.tile-cancel { color: #999; }
.tile-confirm { color: #F0575A; font-weight: 600; }

/* BN批：快速创建弹窗（居中卡片，仿原生弹窗的底部双按钮） */
.qc-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 60;
}
.qc-modal {
  position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 78vw; background: #FFF; border-radius: 12px; z-index: 61;
  padding: 20px 20px 0; box-sizing: border-box;
}
.qc-title { text-align: center; font-size: 16px; font-weight: 600; margin-bottom: 14px; }
.qc-row {
  display: flex; align-items: center; padding: 10px 0;
  border-bottom: 1px solid #F0F0F0;
}
.qc-row-last { border-bottom: none; }
.qc-label { width: 44px; font-size: 14px; color: #333; flex-shrink: 0; }
.qc-input { flex: 1; font-size: 14px; }
.qc-hint { font-size: 12px; color: #B5B5B5; text-align: center; padding: 10px 0 14px; }
.qc-btns { display: flex; border-top: 1px solid #F0F0F0; margin: 0 -20px; }
.qc-btn { flex: 1; text-align: center; padding: 13px 0; font-size: 15px; }
.qc-btn-cancel { color: #333; border-right: 1px solid #F0F0F0; }
.qc-btn-confirm { color: #576B95; font-weight: 600; }
