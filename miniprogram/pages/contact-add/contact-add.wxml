<!-- 新增亲友 -->
<view class="card">
  <view class="form-row">
    <text class="form-label">姓名</text>
    <input class="form-val" placeholder="请输入姓名" placeholder-style="color:#C2C2C2"
      value="{{name}}" bindinput="onNameInput" />
  </view>
  <view class="form-row">
    <text class="form-label">备注</text>
    <input class="form-val" placeholder="可填写备注，如：同学" placeholder-style="color:#C2C2C2"
      value="{{remark}}" bindinput="onRemarkInput" />
  </view>
</view>

<view style="height:90px"></view>
<view class="btn-primary btn-bottom" bindtap="onSave">保存</view>
