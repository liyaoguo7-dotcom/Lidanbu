/* 往来竖线树 */
.member-tip {
  text-align: center;
  color: #C2C2C2;
  font-size: 12px;
  padding: 8px 0 0;
}
/* 差额：淡黄底红字（沿用 v3.1） */
.diff-bar {
  margin: 12px 12px;
  padding: 14px 16px;
  background: #FDF6E3;
  border-radius: 12px;
  color: #E05353;
  font-size: 15px;
  font-weight: 700;
  text-align: center;
}
.timeline-card { padding: 8px 0; }
.tl-item {
  display: flex;
  align-items: flex-start;
  padding: 10px 16px 10px 0;
  position: relative;
}
.tl-date {
  width: 92px;
  flex: none;
  font-size: 12px;
  color: #C2C2C2;
  text-align: right;
  padding-top: 3px;
}
.tl-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #E05353;
  flex: none;
  margin: 4px 12px 0;
  position: relative;
  z-index: 1;
}
.tl-item::before {
  content: '';
  position: absolute;
  left: 111px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #F0E6D4;
}
.tl-item:first-child::before { top: 16px; }
.tl-item:last-child::before { bottom: auto; height: 18px; }
.tl-body { flex: 1; display: flex; flex-direction: column; }
/* 金额深色文字，方向靠 +/- 号（不用红绿蓝） */
.tl-amt { font-size: 17px; font-weight: 700; color: #333; }
.tl-desc { font-size: 13px; color: #666; margin-top: 3px; }
.tl-pen {
  font-size: 18px;
  color: #C2C2C2;
  padding: 4px 0 4px 12px;
  flex: none;
}
.empty { text-align: center; padding: 60px 0; }
.empty-text { color: #C2C2C2; font-size: 14px; }
