/* 往来竖线树 · v3.1 14.2 双栏（左送出/右收到） */
.member-tip {
  text-align: center;
  color: #C2C2C2;
  font-size: 24rpx;
  padding: 16rpx 0 0;
  background: #fff;
}
/* 标题下淡金色栏：左送出/右收到，白字 */
.kindbar {
  display: flex;
  background: #CEA64F;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.kind-half {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}
/* 双栏时间线：竖线贯穿到底 */
.tl {
  position: relative;
  background: #fff;
  padding: 36rpx 0 12rpx;
}
.tl-line {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: #D9C9A8;
  transform: translateX(-50%);
}
.trow {
  position: relative;
  display: flex;
  min-height: 128rpx;
  padding: 16rpx 0;
}
.tcell {
  flex: 1;
  padding: 0 28rpx;
}
.tcell.left { text-align: right; }
.tcell.right { text-align: left; }
/* 每条竖线上的红点 */
.tdot {
  position: absolute;
  left: 50%;
  top: 52rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E05353;
  transform: translateX(-50%);
  z-index: 1;
  flex: none;
}
/* 每条三行：日期（灰）→事由→金额（黑粗体，¥前缀） */
.tdate {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.treason {
  font-size: 28rpx;
  color: #333;
}
/* 钢笔线条图标（禁用表情符号）
   图标本体 28rpx 不变；用 padding 扩可点区到 88rpx 见方、负 margin 抵消布局位移，
   保证可点区域 ≥44px 而版式与定版图逐像素一致（2026-10-21 质量回归修复）。 */
.tpen {
  width: 28rpx;
  height: 28rpx;
  padding: 30rpx 30rpx 30rpx 42rpx;
  margin: -30rpx -30rpx -30rpx -30rpx;
  vertical-align: -4rpx;
}
.tamt {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
  margin-top: 6rpx;
}
/* 底部汇总：淡黄底，紧跟时间线最下方，不悬浮，居中三行 */
.sumbar {
  background: #FDF6E3;
  text-align: center;
  padding: 28rpx 0 36rpx;
  font-size: 30rpx;
  line-height: 2;
  color: #333;
}
.sumbar .dl {
  color: #E05353;
  font-weight: 700;
}
.empty { text-align: center; padding: 120rpx 0; background: #fff; }
.empty-text { color: #C2C2C2; font-size: 28rpx; }
