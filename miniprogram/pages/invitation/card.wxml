<!-- 电子请柬正页卡片模板（预览页/客人页共用；data 传 card-view.buildCard 的结果）
     装饰全部为原创 CSS 几何纹样：方角菱形 / 印记圆点 / 拱形框 / 年轮同心圈，
     不使用任何图片素材（版权红线见 docs/references/invitation/README.md） -->
<template name="inv-card">
  <view class="inv-paper" style="{{cardCss}}">
    <!-- 国潮：四角双线方角 + 菱形点 -->
    <block wx:if="{{deco === 'corner-diamond'}}">
      <view class="cnr cnr-tl" style="border-color:{{primary}}"><view class="dia" style="background:{{primary}}"></view></view>
      <view class="cnr cnr-tr" style="border-color:{{primary}}"><view class="dia" style="background:{{primary}}"></view></view>
      <view class="cnr cnr-bl" style="border-color:{{primary}}"><view class="dia" style="background:{{primary}}"></view></view>
      <view class="cnr cnr-br" style="border-color:{{primary}}"><view class="dia" style="background:{{primary}}"></view></view>
    </block>
    <!-- 原木：年轮同心圈（印章后衬） -->
    <view wx:if="{{deco === 'rings'}}" class="rings">
      <view class="ring r1" style="border-color:{{accent}}"></view>
      <view class="ring r2" style="border-color:{{accent}}"></view>
    </view>

    <view class="inv-seal" style="background:{{primary}}">{{sealText}}</view>
    <!-- 奶油：印记两侧细金线 -->
    <view wx:if="{{deco === 'seal-dot'}}" class="seal-lines">
      <view class="sl" style="background:{{accent}}"></view>
      <view class="sd" style="background:{{primary}}"></view>
      <view class="sl" style="background:{{accent}}"></view>
    </view>

    <view class="inv-type" style="color:{{primary}}">{{typeName}} · 邀请函</view>
    <view class="inv-title">{{title}}</view>
    <view class="inv-host" style="color:{{sub}}">{{hostName}} 敬邀</view>
    <view class="inv-line" style="background:{{line}}"></view>
    <view class="inv-row"><text class="inv-k" style="color:{{sub}}">时间</text><text class="inv-v">{{dateText}}</text></view>
    <view class="inv-row"><text class="inv-k" style="color:{{sub}}">地点</text><text class="inv-v">{{address}}</text></view>
    <view wx:if="{{mapLocName}}" class="inv-maploc" style="color:{{primary}}">定位：{{mapLocName}}</view>
    <view wx:if="{{blessing}}" class="inv-blessing">{{blessing}}</view>
  </view>
</template>
