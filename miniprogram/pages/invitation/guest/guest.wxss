@import "../card.wxss";
/* 请柬客人页 */
.inv-page { min-height: 100vh; padding-top: 2px; }
.rsvp-card { padding-bottom: 16px; }
.rsvp-title { padding: 16px 16px 4px; font-size: 16px; }
.attend-chips { display: flex; gap: 8px; flex: 1; }
.attend-chips .chip {
  padding: 7px 16px; border-radius: 16px; font-size: 13px;
  background: #F5F6F4; color: #333;
}
.attend-chips .chip.on { background: #F1E6D3; color: #E05353; font-weight: 600; }
.stepper { display: flex; align-items: center; gap: 14px; }
.step-btn {
  /* 可点区域 ≥44px（2026-10-21 质量回归修复，原 30px 偏小） */
  width: 44px; height: 44px; border-radius: 50%;
  border: 1px solid #E0D8C8; color: #E05353; font-size: 20px;
  display: flex; align-items: center; justify-content: center;
}
.step-num { font-size: 16px; min-width: 22px; text-align: center; }
.step-hint { margin-left: 10px; font-size: 12px; color: #C2C2C2; }
.submit-btn { margin-top: 16px; }
.empty { padding: 28px 20px; text-align: center; }
.empty-title { font-size: 17px; }
.empty-desc { margin-top: 8px; font-size: 13px; color: #999; }
