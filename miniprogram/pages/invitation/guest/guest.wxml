<import src="../card.wxml" />
<!-- 请柬客人页：正页 + 回执表单 -->
<view class="inv-page" style="{{card.pageCss}}" wx:if="{{card}}">
  <template is="inv-card" data="{{...card}}" />

  <view class="card rsvp-card">
    <view class="rsvp-title songti">{{submitted ? '我的回执（可修改后重新提交）' : '回执：您来参加吗？'}}</view>
    <view class="form-row">
      <text class="form-label">姓名</text>
      <input class="form-val" placeholder="请填写您的姓名" placeholder-style="color:#C2C2C2"
        value="{{form.guestName}}" bindinput="onNameInput" maxlength="30" />
    </view>
    <view class="form-row">
      <text class="form-label">是否参加</text>
      <view class="attend-chips">
        <view wx:for="{{attendOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="onAttendTap"
          class="chip {{form.attend === item.id ? 'on' : ''}}">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row" wx:if="{{form.attend === 'attend'}}">
      <text class="form-label">人数</text>
      <view class="stepper">
        <view class="step-btn" bindtap="onMinus">−</view>
        <text class="step-num num">{{form.count}}</text>
        <view class="step-btn" bindtap="onPlus">＋</view>
      </view>
      <text class="step-hint">含您本人</text>
    </view>
    <view class="form-row">
      <text class="form-label">留言</text>
      <input class="form-val" placeholder="想对主人说的话（可不填）" placeholder-style="color:#C2C2C2"
        value="{{form.note}}" bindinput="onNoteInput" maxlength="100" />
    </view>
    <view class="btn-primary submit-btn" bindtap="onSubmit">{{submitted ? '更新回执' : '提交回执'}}</view>
  </view>
  <view style="height:16px"></view>
</view>
<view wx:if="{{notFound}}" class="card empty">
  <view class="empty-title songti">这份请柬找不到了</view>
  <view class="empty-desc">可能已经被主人删除了。</view>
</view>
