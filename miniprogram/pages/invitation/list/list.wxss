/* 我的请柬列表 */
.empty { padding: 28px 20px; text-align: center; }
.empty-title { font-size: 17px; }
.empty-desc { margin-top: 10px; font-size: 13px; color: #999; line-height: 1.7; white-space: pre-line; }
.empty-btn { margin: 18px 12px 4px; }

.inv-item { display: flex; align-items: center; padding: 14px 16px; }
.inv-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; margin-right: 12px; }
.inv-main { flex: 1; min-width: 0; }
.inv-title { font-size: 16px; }
.inv-sub { margin-top: 4px; font-size: 12px; color: #999; }
.inv-ops { flex: none; display: flex; gap: 14px; margin-left: 10px; }
.inv-ops .op { font-size: 13px; color: #666; padding: 6px 0; }
.inv-ops .del { color: #F0575A; }
