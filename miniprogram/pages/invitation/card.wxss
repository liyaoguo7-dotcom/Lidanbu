/* 电子请柬正页卡片样式（与 card.wxml 模板配套；颜色全部由模板内联传入，不写死） */
.inv-paper {
  position: relative;
  margin: 14px 12px;
  padding: 34px 26px 30px;
  border-radius: 14px;
  text-align: center;
  overflow: hidden;
}
.inv-seal {
  width: 44px; height: 44px; margin: 0 auto;
  border-radius: 8px;
  color: #fff; font-size: 24px; line-height: 44px; text-align: center;
}
.inv-type { margin-top: 16px; font-size: 13px; letter-spacing: 4px; }
.inv-title { margin-top: 10px; font-size: 25px; font-weight: 600; line-height: 1.35; }
.inv-host { margin-top: 8px; font-size: 14px; }
.inv-line { height: 1px; margin: 20px 6px; }
.inv-row { display: flex; justify-content: center; gap: 10px; font-size: 15px; padding: 4px 0; }
.inv-k { flex: none; }
.inv-v { text-align: left; }
.inv-maploc { margin-top: 6px; font-size: 13px; }
.inv-blessing { margin-top: 18px; font-size: 14px; line-height: 1.8; padding: 0 8px; }

/* 国潮四角（双线感由边框+内菱形点构成，原创几何） */
.cnr { position: absolute; width: 26px; height: 26px; }
.cnr .dia {
  position: absolute; width: 7px; height: 7px;
  transform: rotate(45deg);
}
.cnr-tl { top: 7px; left: 7px; border-top: 2px solid; border-left: 2px solid; }
.cnr-tr { top: 7px; right: 7px; border-top: 2px solid; border-right: 2px solid; }
.cnr-bl { bottom: 7px; left: 7px; border-bottom: 2px solid; border-left: 2px solid; }
.cnr-br { bottom: 7px; right: 7px; border-bottom: 2px solid; border-right: 2px solid; }
.cnr-tl .dia { bottom: 2px; right: 2px; }
.cnr-tr .dia { bottom: 2px; left: 2px; }
.cnr-bl .dia { top: 2px; right: 2px; }
.cnr-br .dia { top: 2px; left: 2px; }

/* 奶油印记细线 */
.seal-lines { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 14px; }
.seal-lines .sl { width: 52px; height: 1px; }
.seal-lines .sd { width: 6px; height: 6px; border-radius: 50%; }

/* 原木年轮同心圈 */
.rings { position: absolute; top: 16px; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; }
.ring { position: absolute; border: 1px solid; border-radius: 50%; }
.ring.r1 { width: 58px; height: 58px; top: -7px; }
.ring.r2 { width: 74px; height: 74px; top: -15px; opacity: .55; }
