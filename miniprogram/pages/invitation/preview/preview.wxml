<import src="../card.wxml" />
<!-- 请柬预览（主人视角） -->
<view class="inv-page" style="{{card.pageCss}}" wx:if="{{card}}">
  <template is="inv-card" data="{{...card}}" />
  <view class="hint">这就是朋友打开时看到的样子</view>
  <!-- 分享卡片封面：风格文字卡（标题+主人+日期，按本风格配色） -->
  <view class="share-cover" style="background:{{card.primary}}">
    <view class="sc-type">{{card.typeName}} · 邀请函</view>
    <view class="sc-title">{{card.title}}</view>
    <view class="sc-sub">{{card.hostName}} 敬邀 · {{card.dateText}}</view>
  </view>
  <button class="btn-primary share-btn" open-type="share">分享给朋友</button>
  <view class="ops-row">
    <view class="op-btn" bindtap="onStats">查看回执</view>
    <view class="op-btn" bindtap="onEdit">编辑请柬</view>
  </view>
  <view style="height:20px"></view>
</view>
<view wx:if="{{notFound}}" class="card empty">
  <view class="empty-title songti">这份请柬找不到了</view>
  <view class="empty-desc">可能已经被删除了。</view>
</view>
