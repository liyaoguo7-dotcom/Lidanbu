/* 请柬回执统计 */
.sum-card { padding: 16px; }
.sum-title { font-size: 16px; text-align: center; }
.sum-grid { display: flex; margin-top: 14px; }
.sum-cell { flex: 1; text-align: center; }
.sum-num { font-size: 24px; font-weight: 600; }
.sum-num.ok { color: #E05353; }
.sum-label { margin-top: 4px; font-size: 11px; color: #999; }
.sum-note { margin-top: 12px; font-size: 12px; color: #999; line-height: 1.6; text-align: center; }
.sum-share { margin: 12px 12px 2px; border: none; }
.sum-share::after { border: none; }
.rsvp-item { display: flex; align-items: center; padding: 12px 16px; }
.r-main { flex: 1; min-width: 0; }
.r-name { font-size: 15px; }
.r-attend { margin-left: 8px; font-size: 12px; color: #999; }
.r-attend.a-attend { color: #E05353; font-weight: 600; }
.r-note { margin-top: 4px; font-size: 12px; color: #999; }
.r-add {
  flex: none; font-size: 13px; color: #E05353;
  border: 1px solid #F0575A; border-radius: 16px; padding: 6px 12px;
}
.r-added { flex: none; font-size: 12px; color: #C2C2C2; }
.empty { padding: 24px 20px; text-align: center; font-size: 13px; color: #999; }
.empty-title { font-size: 17px; color: #333; }
.empty-desc { margin-top: 8px; font-size: 13px; }
