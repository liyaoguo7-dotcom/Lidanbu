<!-- 请柬回执统计 -->
<view wx:if="{{stats}}">
  <view class="card sum-card">
    <view class="sum-title songti">{{title}}</view>
    <view class="sum-grid">
      <view class="sum-cell">
        <view class="sum-num num ok">{{stats.attendPeople}}</view>
        <view class="sum-label">确定参加（人）</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num num">{{stats.attendParties}}</view>
        <view class="sum-label">参加（组）</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num num">{{stats.absentParties}}</view>
        <view class="sum-label">不参加（组）</view>
      </view>
      <view class="sum-cell">
        <view class="sum-num num">{{stats.undecidedParties}}</view>
        <view class="sum-label">未定（组）</view>
      </view>
    </view>
    <view class="sum-note">共收到 {{stats.total}} 份回执。还没回执的亲友，可以再把请柬转发提醒一下。</view>
    <button class="btn-primary sum-share" open-type="share">转发请柬</button>
  </view>

  <view class="section-title">回执名单</view>
  <view wx:if="{{list.length === 0}}" class="card empty">还没有人回执，发出去等等看～</view>
  <view class="card rsvp-item" wx:for="{{list}}" wx:key="_id">
    <view class="r-main">
      <view class="r-name">{{item.guestName}}
        <text class="r-attend a-{{item.attend}}">{{item.attendName}}{{item.attend === 'attend' ? ' · ' + item.count + '人' : ''}}</text>
      </view>
      <view wx:if="{{item.note}}" class="r-note">留言：{{item.note}}</view>
    </view>
    <view wx:if="{{item.attend === 'attend' && !item.contactId}}" class="r-add"
      data-id="{{item._id}}" bindtap="onAddContact">加入亲友录</view>
    <view wx:if="{{item.contactId}}" class="r-added">已在亲友录</view>
  </view>
  <view style="height:20px"></view>
</view>
<view wx:if="{{notFound}}" class="card empty">
  <view class="empty-title songti">这份请柬找不到了</view>
  <view class="empty-desc">可能已经被删除了。</view>
</view>
