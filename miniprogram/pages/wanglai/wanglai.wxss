/* 往来页（v3.1 第五章） */
/* BA批：整页 100vh 纵向 flex——上半部分（时间/搜索/汇总/差额）固定不滚，
   下方联系人列表区（.wl-scroll）独立滚动 */
.wl-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
/* BG批：列表区整片白底——与上方对照卡/合计/差额连成一片，滚动区里也不露灰 */
.wl-scroll { flex: 1; height: 0; background: #fff; }
.wl-scroll .card { margin: 0; border-radius: 0; }
/* 任务AC 第 7 项（用户标"重点"）：本页全部文字字号整体大一号（+1px），只动本页、不动全局。
   姓名原名义 16px 与其他列表页同值，但用户观感明显偏小（疑与同行 13~15px 小字衬托有关），按用户原话整体 +1。 */
.member-tip {
  text-align: center;
  color: #C2C2C2;
  font-size: 13px;
  padding: 8px 0 0;
}
/* 时间标签行 */
/* AP批版式：整页上移——顶部 padding 10px→6px；头部区与下方各白卡之间留
   明确的独立灰隔，不再连成一片灰带（对照卡 margin-top 配合见 .compare） */
.timerow {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 6px 12px 2px;
  flex-wrap: wrap;
}
.tchip {
  font-size: 14px;
  color: #666;
  border: 1px solid #E5E5E5;
  border-radius: 15px;
  padding: 5px 13px;
  background: #fff;
}
.tchip.on { color: #E05353; border-color: #E05353; }
/* BX批六色：6 个时间按钮按顺序配首页六色（选中态红字红边不变，压在淡色底上） */
.tchip.chip-all { background: #E2EEFB; }
.tchip.chip-today { background: #FDE8E8; }
.tchip.chip-month { background: #FDEFCB; }
.tchip.chip-year { background: #E0F3E4; }
.tchip.chip-lastYear { background: #FFC7C3; }
.tchip.chip-custom { background: #FFE4B8; }
/* CE批（用户 2026-10-29 定）：收送两块仍各自独立并排（不是一张卡内分栏），两块都改今日粉 #FDE8E8（取代 CD 的今年绿）；CJ批：底色与圆角收进 .side，见下 */
.custom-range { display: flex; align-items: center; justify-content: center; margin-top: 10px; gap: 8px; }
.date-box {
  padding: 8px 12px;
  background: #F5F6F4;
  border-radius: 8px;
  font-size: 15px;
}
.dash { color: #C2C2C2; }
.daterange {
  text-align: center;
  font-size: 13px;
  color: #999;
  padding: 4px 0 2px;
}
/* AP批：搜索框行与"全部时间"行的距离缩小（全局 .searchbar 上下 10px →
   本页 4px；与 .daterange 下边距合计 14px→6px）。只覆盖本页，不动全局。
   BG批：下 padding 归 0，搜索行直接接下方白色方块列、不留灰缝。 */
.searchbar { padding: 4px 12px 0; }
/* 左右对照：收礼（左）、送礼（右）；上总额、下笔数 */
/* BG批（用户点名，覆盖 AP 的灰隔版式）：从对照卡起，合计行、差额条、
   联系人名单连成一整片——全宽、无圆角、方块挨方块，之间不露一点灰，
   整页随之变紧凑。 */
/* CJ批（用户 2026-10-29 定，预览图确认）：收送两块彻底独立——容器不再是
   一张卡（去底色、去圆角、去裁剪），两块之间留 12px 空隙，各自全圆角，
   中间分隔线取消。颜色不动：收送仍今日粉，合计卡仍本月淡黄。 */
.compare {
  display: flex;
  gap: 12px;
  margin: 6px 12px 0;
}
/* CD批（用户定）：合计与差额合并进一个方块，用本月人情往来长条淡黄；两行上下靠紧 */
.summary-card {
  margin: 8px 12px 0;
  background: #FBF3D9;
  border-radius: 12px;
  overflow: hidden;
}
.summary-card .total-line { background: transparent; padding: 8px 0 2px; }
.summary-card .diff-bar { background: transparent; margin: 0; padding: 2px 16px 8px; }
/* CD批（用户定）：联系人行背景恢复纯白 */
.wl-row.rowbg { background: #FFFFFF; }
.side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 0;
  border-radius: 12px;
}
/* CP批（用户 2026-10-29 定）：往来收送两块颜色一比一复刻首页两大卡
   （只复刻底色渐变，方块大小、间距、圆角、文字色都不动；阴影不抄）：
   收礼 ← 首页收礼橙黄渐变，送礼 ← 首页送礼粉红渐变 */
.side:first-child { background: linear-gradient(135deg, #FFE4B8, #FDBE68); }
.side:last-child { background: linear-gradient(135deg, #FFC7C3, #F78C8F); }
.side-label {
  font-size: 15px;
  color: #333;
}
.side-amount {
  font-size: 23px;
  font-weight: 700;
  color: #333;
  margin-top: 6px;
}
.side-count { font-size: 13px; color: #999; margin-top: 4px; }
/* 合计（BG批：白底，与上下方块直接贴合，不再坐在灰底上） */
.total-line {
  text-align: center;
  font-size: 14px;
  color: #666;
  background: #fff;
  padding: 8px 0;
}
/* 差额区：淡黄底红字，绝对值无符号 */
.diff-bar {
  margin: 0;
  padding: 12px 16px;
  background: #FDEFCB;
  color: #E05353;
  text-align: center;
}
.diff-label {
  font-size: 16px;
  font-weight: 700;
}
.diff-amount { font-size: 16px; font-weight: 700; margin-left: 8px; }
/* AP批：联系人行间隔加大（上下 padding 9px→13px，行高随之 +8px） */
.wl-row {
  display: flex;
  align-items: center;
  padding: 13px 16px;
  border-bottom: 1px solid #F0F0F0;
}
.wl-row:last-child { border-bottom: none; }
/* BX批：往来主列表卡片裁溢出（统一淡色行贴合圆角） */
.wl-card { overflow: hidden; }
.wl-row .nm {
  font-size: 18px;
  font-weight: 600;
  flex: 1;
  /* 姓名与首页最近往来同字体（默认黑体）：2026-10-22 统一，原宋字体声明删除 */
}
.wl-row .right { display: flex; align-items: center; }
.wl-row .count { font-size: 14px; color: #C2C2C2; }
.wl-row .sep { font-size: 14px; color: #C2C2C2; margin: 0 4px; }
.wl-row .diff { font-size: 16px; color: #333; font-weight: 600; }
.wl-row .chev { color: #C2C2C2; margin-left: 6px; }
.contact-row {
  display: flex;
  align-items: center;
  padding: 13px 16px;
  border-bottom: 1px solid #F0F0F0;
}
.contact-row:last-child { border-bottom: none; }
.contact-row .nm { font-size: 18px; font-weight: 600; }
.contact-row .rmk { font-size: 14px; color: #C2C2C2; margin-left: 8px; flex: 1; }
.contact-row .ph { color: #C2C2C2; font-size: 15px; }
.empty { text-align: center; padding: 60px 0; }
.empty-text { color: #C2C2C2; font-size: 15px; }
