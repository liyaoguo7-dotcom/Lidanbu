/* 往来页 */
.member-tip {
  text-align: center;
  color: #C2C2C2;
  font-size: 12px;
  padding: 8px 0 0;
}
.range-card { padding: 12px 16px; }
.chips { display: flex; flex-wrap: wrap; gap: 10px; }
.chip {
  padding: 8px 18px;
  border-radius: 20px;
  background: #F5F6F4;
  color: #333;
  font-size: 14px;
}
.chip.on { background: #F1E6D3; color: #E05353; font-weight: 700; }
.custom-range { display: flex; align-items: center; margin-top: 12px; gap: 8px; }
.date-box {
  padding: 8px 12px;
  background: #F5F6F4;
  border-radius: 8px;
  font-size: 14px;
}
.dash { color: #C2C2C2; }
.summary { padding: 14px 16px; font-size: 14px; font-weight: 600; }
/* 差额：淡黄底红字（沿用 v3.1） */
.diff-bar {
  margin: 0 12px 12px;
  padding: 14px 16px;
  background: #FDF6E3;
  border-radius: 12px;
  color: #E05353;
  font-size: 15px;
  font-weight: 700;
  text-align: center;
}
.wl-row {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #F0F0F0;
}
.wl-row:last-child { border-bottom: none; }
.wl-row .nm { font-size: 16px; font-weight: 600; flex: 1; }
.wl-row .right { display: flex; align-items: center; }
.wl-row .count { font-size: 13px; color: #C2C2C2; }
.wl-row .sep { font-size: 13px; color: #C2C2C2; margin: 0 4px; }
.wl-row .diff { font-size: 15px; color: #333; font-weight: 600; }
.wl-row .chev { color: #C2C2C2; margin-left: 6px; }
.contact-row {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #F0F0F0;
}
.contact-row:last-child { border-bottom: none; }
.contact-row .nm { font-size: 16px; font-weight: 600; }
.contact-row .rmk { font-size: 13px; color: #C2C2C2; margin-left: 8px; flex: 1; }
.contact-row .ph { color: #C2C2C2; font-size: 14px; }
.empty { text-align: center; padding: 60px 0; }
.empty-text { color: #C2C2C2; font-size: 14px; }
