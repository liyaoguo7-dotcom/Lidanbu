/* 往来页（v3.1 第五章） */
.member-tip {
  text-align: center;
  color: #C2C2C2;
  font-size: 12px;
  padding: 8px 0 0;
}
/* 时间标签行 */
.timerow {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 10px 12px 2px;
  flex-wrap: wrap;
}
.tchip {
  font-size: 13px;
  color: #666;
  border: 1px solid #E5E5E5;
  border-radius: 15px;
  padding: 5px 13px;
  background: #fff;
}
.tchip.on { color: #E05353; border-color: #E05353; }
.custom-range { display: flex; align-items: center; justify-content: center; margin-top: 10px; gap: 8px; }
.date-box {
  padding: 8px 12px;
  background: #F5F6F4;
  border-radius: 8px;
  font-size: 14px;
}
.dash { color: #C2C2C2; }
.daterange {
  text-align: center;
  font-size: 12px;
  color: #999;
  padding: 6px 0 4px;
}
/* 左右对照：收礼（左）、送礼（右）；上总额、下笔数 */
.compare {
  display: flex;
  margin: 4px 12px 0;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}
.side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 0;
}
.side + .side { border-left: 1px solid #F0F0F0; }
.side-label {
  font-size: 14px;
  color: #333;
}
.side-amount {
  font-size: 22px;
  font-weight: 700;
  color: #333;
  margin-top: 6px;
}
.side-count { font-size: 12px; color: #999; margin-top: 4px; }
/* 合计 */
.total-line {
  text-align: center;
  font-size: 13px;
  color: #666;
  padding: 10px 0 2px;
}
/* 差额区：淡黄底红字，绝对值无符号 */
.diff-bar {
  margin: 8px 12px 12px;
  padding: 14px 16px;
  background: #FDF6E3;
  border-radius: 12px;
  color: #E05353;
  text-align: center;
}
.diff-label {
  font-size: 15px;
  font-weight: 700;
}
.diff-amount { font-size: 15px; font-weight: 700; margin-left: 8px; }
.wl-row {
  display: flex;
  align-items: center;
  padding: 9px 16px;
  border-bottom: 1px solid #F0F0F0;
}
.wl-row:last-child { border-bottom: none; }
.wl-row .nm {
  font-size: 16px;
  font-weight: 600;
  flex: 1;
  /* 姓名与首页最近往来同字体（默认黑体）：2026-10-22 统一，原宋字体声明删除 */
}
.wl-row .right { display: flex; align-items: center; }
.wl-row .count { font-size: 13px; color: #C2C2C2; }
.wl-row .sep { font-size: 13px; color: #C2C2C2; margin: 0 4px; }
.wl-row .diff { font-size: 15px; color: #333; font-weight: 600; }
.wl-row .chev { color: #C2C2C2; margin-left: 6px; }
.contact-row {
  display: flex;
  align-items: center;
  padding: 9px 16px;
  border-bottom: 1px solid #F0F0F0;
}
.contact-row:last-child { border-bottom: none; }
.contact-row .nm { font-size: 16px; font-weight: 600; }
.contact-row .rmk { font-size: 13px; color: #C2C2C2; margin-left: 8px; flex: 1; }
.contact-row .ph { color: #C2C2C2; font-size: 14px; }
.empty { text-align: center; padding: 60px 0; }
.empty-text { color: #C2C2C2; font-size: 14px; }
