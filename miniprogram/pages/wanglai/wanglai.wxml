<!-- 往来页（v3.1 第五章；DC批取代 BA 固定头：整页正常滑动；搜索框＋收送两块
     ＋合计卡包一层 sticky——往上滑、时间标签滑走后，搜索框滑到顶部时整组停住
     固定，下面只剩联系人滑动） -->
<view class="wl-page {{swipeAnim ? 'swipe-back' : ''}}" style="position: relative; left: {{swipeX}}px" bindtouchstart="onTabSwipeStart" bindtouchmove="onTabSwipeMove" bindtouchend="onTabSwipeEnd">
<view class="member-tip" wx:if="{{isMember}}">仅统计已授权给你的记录</view>

<!-- 时间标签 -->
<view class="timerow">
  <text class="tchip chip-{{item.id}} {{item.id === rangeId ? 'on' : ''}}" wx:for="{{ranges}}" wx:key="id"
    data-id="{{item.id}}" bindtap="onRangeTap">{{item.name}}</text>
</view>
<view class="custom-range" wx:if="{{rangeId === 'custom'}}">
  <picker mode="date" value="{{customFrom}}" bindchange="onCustomFromChange">
    <view class="date-box num">{{customFrom}}</view>
  </picker>
  <text class="dash">—</text>
  <picker mode="date" value="{{customTo}}" bindchange="onCustomToChange">
    <view class="date-box num">{{customTo}}</view>
  </picker>
</view>
<view class="daterange num">{{rangeText}}</view>

<!-- DC批 sticky 组：搜索框＋收送两块＋合计卡（搜索时两块与合计卡隐藏，只剩搜索框吸顶） -->
<view class="wl-sticky">
<!-- 搜索框 -->
<view class="searchbar">
  <view class="searchbox">
    <input placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput"
      placeholder-style="color:#C2C2C2" style="flex:1;font-size:14px" />
  </view>
  <text class="search-cancel" bindtap="onCancelSearch">取消</text>
</view>

<block wx:if="{{!searching}}">
  <!-- 左右对照：收礼（左）、送礼（右）；上总额、下笔数 -->
  <!-- CS批（用户 2026-10-29 定）：往来也改成左送礼、右收礼（与首页两大卡左右一致） -->
  <view class="compare">
    <view class="side">
      <text class="side-label">送礼</text>
      <text class="side-amount num">{{giftTotalText}}</text>
      <text class="side-count">{{giftCountText}}</text>
    </view>
    <view class="side">
      <text class="side-label">收礼</text>
      <text class="side-amount num">{{receiveTotalText}}</text>
      <text class="side-count">{{receiveCountText}}</text>
    </view>
  </view>

  <!-- 合计＋差额合并卡（CD批：两行靠紧，淡黄本月长条色） -->
  <view class="summary-card">
    <view class="total-line">{{totalText}}</view>
    <view class="diff-bar">
      <text class="diff-label">差额</text>
      <text class="diff-amount num">{{diffText}}</text>
    </view>
  </view>
</block>
</view>

<!-- 联系人列表区：随整页滑动（搜索结果也落在这一区） -->
<view class="wl-list">
  <!-- 搜索结果 -->
  <view class="card" wx:if="{{searching}}">
    <view class="contact-row" wx:for="{{searchResults}}" wx:key="contactId"
      data-id="{{item.contactId}}" data-name="{{item.name}}" bindtap="goTimeline">
      <text class="nm">{{item.name}}</text>
      <text class="rmk" wx:if="{{item.remark}}">{{item.remark}}</text>
      <text class="chev">›</text>
    </view>
    <view class="contact-row" wx:if="{{searchResults.length === 0}}">
      <text class="ph">没有找到相关亲友</text>
    </view>
  </view>

  <block wx:if="{{!searching}}">
    <!-- 亲友列表 -->
    <view class="card wl-card" wx:if="{{rows.length > 0}}">
      <!-- BV批斑马：主列表按单双号交替（搜索结果不做，用户定） -->
      <view class="wl-row rowbg" wx:for="{{rows}}" wx:key="contactId" data-id="{{item.contactId}}" data-name="{{item.name}}" bindtap="goTimeline">
        <text class="nm">{{item.name}}</text>
        <view class="right">
          <text class="count">{{item.countText}}</text>
          <text class="sep">｜</text>
          <text class="diff num">{{item.diffText}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{rows.length === 0}}">
      <text class="empty-text">该时间范围内暂无往来记录</text>
    </view>
  </block>
</view>
</view>
