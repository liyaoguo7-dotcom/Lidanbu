/* 送礼示例页：版式与真实送礼列表/详情页一致 */
.example-bar {
  margin: 12px 12px 0;
  padding: 8px 12px;
  background: #FDF3D8;
  color: #9A7B2D;
  border-radius: 8px;
  font-size: 12.5px;
  text-align: center;
}
.example-note {
  margin: 14px 16px;
  font-size: 12.5px;
  color: #999;
  text-align: center;
}
.total-line { text-align: center; font-size: 20px; padding: 14px 16px 12px; color: #333; border-bottom: 1px solid #F0F0F0; }
.total-line .red { color: #F0575A; font-weight: 600; }
.list-end { display: flex; align-items: center; gap: 10px; padding: 17px 60px 19px; }
.end-line { flex: 1; height: 1px; background: #F0F0F0; }
.end-text { font-size: 12px; color: #C2C2C2; }
.gift-row {
  display: flex;
  align-items: center;
  height: 76px;
  box-sizing: border-box;
  padding: 6px 16px;
  position: relative;
}
.gift-row::after {
  content: ''; position: absolute; left: 84px; right: 0; bottom: 0;
  height: 1px; background: #F0F0F0;
}
.gift-row.last::after { display: none; }
.pat {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #F1E6D3;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.pat.baishi { background: #E8EAED; }
.pat-img { width: 40px; height: 40px; }
.mid { flex: 1; margin-left: 12px; display: flex; flex-direction: column; }
.nm { font-size: 16px; font-weight: 600; }
.subline { display: flex; flex-direction: row; align-items: baseline; margin-top: 3px; }
.sub { font-size: 13px; color: #999; }
.amt { font-size: 17px; font-weight: 600; }
.back-row {
  margin: 12px 16px 2px;
  font-size: 14px;
  color: #E05353;
  padding: 6px 0;
}
.pat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 16px 16px;
}
.pat-big {
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: #F1E6D3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pat-big.baishi { background: #E8EAED; }
.pat-big .pat-img { width: 58px; height: 58px; }
.pat-name { font-size: 16px; margin-top: 10px; }
.pat-name.baishi { color: #3B4046; }
.strong { font-weight: 600; }
.ph { color: #C2C2C2; }
