/* 送礼示例页：版式与真实送礼列表/详情页一致 */
.example-bar {
  margin: 12px 12px 0;
  padding: 8px 12px;
  background: #FDF3D8;
  color: #9A7B2D;
  border-radius: 8px;
  font-size: 12.5px;
  text-align: center;
}
.example-note {
  margin: 14px 16px;
  font-size: 12.5px;
  color: #999;
  text-align: center;
}
.summary { padding: 14px 16px; font-size: 14px; }
.summary .red { color: #E05353; }
.gift-row {
  display: flex;
  align-items: center;
  padding: 12px 2px;
  border-bottom: 1px solid #F0F0F0;
}
.gift-row:last-child { border-bottom: none; }
.pat {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #F1E6D3;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.pat.baishi { background: #E8EAED; }
.pat-img { width: 40px; height: 40px; }
.mid { flex: 1; margin-left: 12px; display: flex; flex-direction: column; }
.nm { font-size: 16px; }
.sub { font-size: 12.5px; color: #999; margin-top: 4px; }
.amt { font-size: 15px; }
.back-row {
  margin: 12px 16px 2px;
  font-size: 14px;
  color: #E05353;
  padding: 6px 0;
}
.pat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 16px 16px;
}
.pat-big {
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: #F1E6D3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pat-big.baishi { background: #E8EAED; }
.pat-big .pat-img { width: 58px; height: 58px; }
.pat-name { font-size: 16px; margin-top: 10px; }
.pat-name.baishi { color: #3B4046; }
.strong { font-weight: 600; }
.ph { color: #C2C2C2; }
