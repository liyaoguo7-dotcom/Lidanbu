/* 礼薄详情 */
.pat-card { text-align: center; padding: 24px 0 14px; position: relative; }
.pat-big {
  width: 72px; height: 72px; border-radius: 50%;
  background: #F1E6D3;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
}
.pat-big.baishi { background: #E8EAED; }
.pat-img { width: 52px; height: 52px; }
.pat-name { font-size: 14px; color: #E05353; font-weight: 700; margin-top: 8px; display: block; }
.pat-name.baishi { color: #3B4046; }
.event-name { font-size: 20px; font-weight: 700; margin-top: 6px; display: block; }
.event-date { font-size: 13px; color: #C2C2C2; margin-top: 4px; display: block; }
.total-line { text-align: center; font-size: 20px; padding: 14px 16px 12px; color: #333; border-bottom: 1px solid #F0F0F0; }
.total-line .red { color: #F0575A; font-weight: 600; }
.list-end { display: flex; align-items: center; gap: 10px; padding: 17px 60px 19px; }
.end-line { flex: 1; height: 1px; background: #F0F0F0; }
.end-text { font-size: 12px; color: #C2C2C2; }
.rec-row {
  display: flex;
  align-items: center;
  height: 76px;
  box-sizing: border-box;
  padding: 6px 16px;
  position: relative;
}
.rec-row::after {
  content: ''; position: absolute; left: 16px; right: 0; bottom: 0;
  height: 1px; background: #F0F0F0;
}
.rec-row.last::after { display: none; }
.mid { flex: 1; display: flex; flex-direction: column; }
.nm { font-size: 16px; font-weight: 600; }
.subline { display: flex; flex-direction: row; align-items: baseline; margin-top: 3px; }
.sub { font-size: 13px; color: #999; }
.amt { font-size: 17px; font-weight: 600; }
.amt.red { color: #F0575A; }
.empty { text-align: center; padding: 40px 0; }
.empty-text { color: #C2C2C2; font-size: 14px; }
/* 底部双大按钮：左删除（描边）右修改（主按钮） */
.bottom-btns {
  position: fixed;
  left: 24px;
  right: 24px;
  bottom: 26px;
  bottom: calc(26px + env(safe-area-inset-bottom));
  display: flex;
  gap: 12px;
}
.btn-outline {
  flex: 1;
  height: 56px;
  line-height: 54px;
  background: #fff;
  color: #F0575A;
  border: 1px solid #F0575A;
  text-align: center;
  font-size: 17px;
  border-radius: 28px;
}
.btn-half {
  flex: 1;
  position: static;
  left: auto;
  right: auto;
  bottom: auto;
}
