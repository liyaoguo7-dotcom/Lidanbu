<!-- 礼薄详情 -->
<view class="card pat-card">
  <!-- 礼薄级修改/删除：卡内右上角小字入口（2026-10-22 真机反馈：原底部按钮条被贴底＋压住，移上来） -->
  <view class="card-actions">
    <text class="card-act" bindtap="goEdit">修改</text>
    <text class="card-act danger" bindtap="onDelete">删除</text>
  </view>
  <view class="pat-big {{isBaishi ? 'baishi' : ''}}">
    <image class="pat-img" src="{{icon}}" mode="aspectFit" />
  </view>
  <text class="songti pat-name {{isBaishi ? 'baishi' : ''}}">{{tagName}}</text>
  <text class="event-name songti">{{event.name}}</text>
  <text class="event-date num">{{date}}</text>
</view>

<view class="card summary">
  <text>共计：</text><text class="red num">{{totalText}}</text>
</view>

<view class="card" wx:if="{{records.length > 0}}">
  <view class="rec-row" wx:for="{{records}}" wx:key="_id" data-id="{{item._id}}" bindtap="goRecordDetail">
    <view class="mid">
      <text class="nm">{{item.name}}</text>
      <text class="sub">{{item.subType}}｜</text><text class="sub num">{{item.subDate}}</text>
    </view>
    <text class="amt red num">{{item.amountText}}</text>
  </view>
</view>

<view class="empty" wx:if="{{records.length === 0}}">
  <text class="empty-text">还没有收礼记录，点击下方＋添加</text>
</view>

<view style="height:84px"></view>

<view class="fab fab-low" bindtap="goAddRecord">＋</view>

<!-- 统一删除弹窗：删除礼薄连带删除全部明细 -->
<confirm-modal show="{{showDelModal}}" title="删除礼薄" content="{{delContent}}"
  bind:confirm="onConfirmDel" bind:cancel="onCancelDel" />
