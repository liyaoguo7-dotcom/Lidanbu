<!-- 礼薄详情 -->
<view class="card pat-card">
  <!-- 礼薄级修改/删除入口已取消（2026-10-22 用户定：收礼列表左滑已有修改/删除，详情页不再放） -->
  <view class="pat-big {{isBaishi ? 'baishi' : ''}}">
    <image class="pat-img" src="{{icon}}" mode="aspectFit" />
  </view>
  <text class="pat-name {{isBaishi ? 'baishi' : ''}}">{{tagName}}</text>
  <text class="event-name">{{event.name}}</text>
  <text class="event-date num">{{date}}</text>
</view>

<!-- 共计与记录合并为一张卡（任务AE 第 8 项，与送礼列表同一版式）：共计居中大字、
     数字红字；细线分隔无灰底间隔；列表末尾「完」 -->
<view class="card list-card">
  <view class="total-line">
    <text>共计：</text><text class="red num">{{totalCount}}</text><text>笔 ¥</text><text class="red num">{{totalAmountText}}</text><text>元</text>
  </view>
  <view class="rec-row {{index === records.length - 1 ? 'last' : ''}}" wx:for="{{records}}" wx:key="_id" data-id="{{item._id}}" bindtap="goRecordDetail">
    <view class="mid">
      <text class="nm">{{item.name}}</text>
      <view class="subline"><text class="sub">{{item.subType}}｜</text><text class="sub num">{{item.subDate}}</text></view>
    </view>
    <text class="amt red num"><text class="sign">+</text>{{item.amountText}}</text>
  </view>
  <view class="list-end" wx:if="{{records.length > 0}}">
    <view class="end-line"></view><text class="end-text">完</text><view class="end-line"></view>
  </view>
</view>

<view class="empty" wx:if="{{records.length === 0}}">
  <text class="empty-text">还没有收礼记录，点击下方＋添加</text>
</view>

<view style="height:84px"></view>

<view class="fab fab-low" bindtap="goAddRecord">＋</view>

