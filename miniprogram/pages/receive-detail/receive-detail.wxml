<!-- 礼薄详情 -->
<!-- DE批（用户 2026-10-30 定）：搜索框单独吸顶；头像头（图案＋标签）滚动；礼薄名＋日期＋共计作为一块吸顶；名字只出现一次，用原来 20px 加粗 -->
<view class="card search-stick">
  <!-- BV批：搜索栏（照送礼记录页：搜索姓名＋取消，本地筛） -->
  <view class="searchbar">
    <view class="searchbox">
      <input placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput"
        placeholder-style="color:#C2C2C2" style="flex:1;font-size:14px" />
    </view>
    <text class="search-cancel" bindtap="onCancelSearch">取消</text>
  </view>
</view>

<!-- DE批：头像头滚动（名字／日期移入下方吸顶块，此处只剩图案＋标签） -->
<view class="card head-card">
  <view class="pat-head {{isBaishi ? 'baishi' : ''}}">
    <view class="pat-big {{isBaishi ? 'baishi' : ''}}">
      <image class="pat-img" src="{{icon}}" mode="aspectFit" />
    </view>
    <text class="pat-name {{isBaishi ? 'baishi' : ''}}">{{tagName}}</text>
  </view>
</view>

<!-- DE批：礼薄名＋日期＋共计一块吸顶（名用原来 20px 加粗；共计搜索时隐藏，与原共计一致） -->
<view class="card info-stick">
  <text class="event-name" wx:if="{{event.name}}">{{event.name}}</text>
  <text class="event-date num">{{date}}</text>
  <view class="total-line event-total {{isBaishi ? 'baishi' : ''}}" wx:if="{{!searching}}"><text>共计：</text><text class="red num">{{totalCount}}</text><text>笔 ¥</text><text class="red num">{{totalAmountText}}</text><text>元</text></view>
</view>

<view class="card pat-card">
  <view class="rec-row {{index === shown.length - 1 ? 'last' : ''}}" wx:for="{{shown}}" wx:key="_id" data-id="{{item._id}}" bindtap="goRecordDetail">
    <view class="mid">
      <text class="nm">{{item.name}}</text>
      <view class="subline"><text class="sub">{{item.subType}}｜</text><text class="sub num">{{item.subDate}}</text></view>
    </view>
    <text class="amt red num"><text class="sign">+</text>{{item.amountText}}</text>
  </view>
  <view class="list-end" wx:if="{{shown.length > 0 && !searching}}">
    <view class="end-line"></view><text class="end-text">完</text><view class="end-line"></view>
  </view>
</view>

<view class="empty" wx:if="{{shown.length === 0 && !searching}}">
  <text class="empty-text">还没有收礼记录，点击下方＋添加</text>
</view>

<view class="empty" wx:if="{{shown.length === 0 && searching}}">
  <text class="empty-text">没有找到相关记录</text>
</view>

<view style="height:84px"></view>

<view class="fab fab-low" bindtap="goAddRecord">＋</view>

