<!-- 首次使用引导：3 屏真实页面截图（分包 packages/guide）+ 配文 -->
<view class="skip" bindtap="onSkip">{{review ? '关闭' : '跳过'}}</view>

<view class="screen" wx:for="{{screens}}" wx:key="caption" wx:if="{{step === index}}">
  <view class="shot-frame">
    <image class="shot" src="{{item.img}}" mode="widthFix" />
  </view>
  <text class="g-title songti">{{item.caption}}</text>
</view>

<view class="dots">
  <view class="dot {{step === index ? 'on' : ''}}" wx:for="{{screens}}" wx:key="caption"></view>
</view>

<button class="btn-primary g-btn" bindtap="onNext">{{step === total - 1 ? '开始使用' : '下一步'}}</button>
<view style="height:30px"></view>
