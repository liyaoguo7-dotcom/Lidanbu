/* 首次使用引导（任务R：真实页面截图主视觉 + 配文） */
.skip {
  position: absolute; top: 12px; right: 16px; z-index: 5;
  font-size: 13px; color: #999;
  padding: 6px 10px;
}
.screen { display: flex; flex-direction: column; align-items: center; padding: 30px 32px 0; }
/* 截图框：固定高度、顶对齐裁切，三屏切换时版式不跳动 */
.shot-frame {
  width: 300px; height: 470px;
  border-radius: 12px; overflow: hidden;
  background: #fff; border: 1px solid #E8DFC9;
  box-shadow: 0 6px 18px rgba(0, 0, 0, .06);
}
.shot { width: 300px; display: block; }
.g-title { font-size: 21px; font-weight: 600; margin-top: 30px; text-align: center; }
.dots { display: flex; justify-content: center; gap: 7px; margin-top: 26px; }
.dots .dot { width: 7px; height: 7px; border-radius: 50%; background: #DDD; }
.dots .dot.on { background: #F0575A; }
.g-btn { margin: 20px 24px 0; }
