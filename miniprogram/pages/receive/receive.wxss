/* 收礼主页 */

/* 小喇叭提示条（2026-10-25 AH批按用户视频复刻：通栏长条、无圆角、图标20px、字14px；
   淡黄底、常驻不闪烁沿用 2026-10-22 任务AB 第 8 项；文字过长
   缓慢向左滚动（轨道样式见 app.wxss .horn-marquee/.horn-track）；× 关闭后本次
   打开期间不再显示，状态只存内存） */
.horn {
  display: flex; align-items: center;
  background: #FFF8E1;
  margin: 0; padding: 10px 12px;
}
.horn-icon { width: 20px; height: 20px; margin-right: 8px; flex: none; }
.horn-text {
  font-size: 14px; color: #E8912D; line-height: 1.5;
}
.horn-ellipsis { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.horn-nowrap { white-space: nowrap; }
.horn-close { color: #E8912D; font-size: 20px; padding: 0 2px 0 8px; flex: none; }

/* 共计行（淡色小字，金额红） */
.total-line { font-size: 12px; color: #C2C2C2; padding: 10px 16px 0; }
.total-num { color: #E05353; font-weight: 600; }

/* 列表 */
.list {
  margin: 8px 12px 12px; background: #fff;
  border-radius: 12px; overflow: hidden;
}
.swipe-wrap { position: relative; border-bottom: 1px solid #F0F0F0; }
.swipe-wrap:last-child { border-bottom: none; }
.swipe-actions {
  position: absolute; right: 0; top: 0; bottom: 0;
  display: flex; z-index: 0;
}
.act {
  width: 56px; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 15px;
}
.act-edit { background: #FCA523; }
.act-del { background: #F06D6A; }
.event-row {
  position: relative; z-index: 1; background: #fff;
  display: flex; align-items: center;
  padding: 8px 16px; min-height: 58px;
}
/* BV批斑马：本页 .event-row 自带白底（全局 .zebra 同优先级会被页样式压住），
   故用双类选择器提权；颜色与别处同一对白／淡米。 */
.event-row.zebra { background: #F7F3EA; }
.pat {
  width: 44px; height: 44px; border-radius: 50%;
  background: #F5F6F4;
  display: flex; align-items: center; justify-content: center;
  flex: none;
}
.pat.baishi { background: #E8EAED; }
.pat-img { width: 30px; height: 30px; }
.mid { flex: 1; margin-left: 12px; display: flex; flex-direction: column; min-width: 0; }
.line1 { display: flex; align-items: baseline; }
.nm { font-size: 16px; font-weight: 600; }
.dt { font-size: 12px; color: #C2C2C2; margin-left: 8px; }
.line2 { margin-top: 3px; font-size: 12px; }
.cnt { color: #C2C2C2; }
.amt { color: #1A1A1A; font-weight: 700; font-size: 14px; }
.more { font-size: 20px; color: #C2C2C2; padding: 8px 0 8px 12px; letter-spacing: 1px; }

.empty { text-align: center; padding-top: 90px; display: flex; flex-direction: column; align-items: center; }
.empty-icon { width: 72px; height: 72px; opacity: .45; }
.empty-text { color: #C2C2C2; font-size: 14px; margin-top: 18px; }
.empty-sample { color: #F0575A; font-size: 14px; margin-top: 14px; }

/* 自定义 Tab 栏占位（任务Z 第 1 项）：栏高 50px + 安全区 + 8px 余量 */
.tabbar-spacer { height: 58px; height: calc(58px + env(safe-area-inset-bottom)); }
