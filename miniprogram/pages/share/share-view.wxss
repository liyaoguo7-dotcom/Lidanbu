/* 共享页（正在查看：家人的账本）2026-10-31 家庭共享闭环批 */
.close-btn {
  position: absolute;
  top: 8px;
  right: 16px;
  width: 32px;
  height: 32px;
  line-height: 32px;
  text-align: center;
  font-size: 26px;
  color: #666;
  z-index: 10;
}
.grant-row {
  display: flex;
  align-items: flex-start;
  padding: 12px 16px 4px;
}
.grant-label {
  font-size: 14px;
  color: #333;
  flex-shrink: 0;
  padding-top: 4px;
}
.capsules {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.capsule {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 13px;
}
.capsule-on {
  background: #E0F3E4;
  color: #2E7D32;
}
.capsule-off {
  background: #EEEEEE;
  color: #999999;
}
.ledger-block {
  display: flex;
  align-items: center;
  margin: 0 16px 12px;
  padding: 14px;
  border-radius: 12px;
  background: linear-gradient(135deg, #FFE4B8, #FDBE68);
}
.ledger-icon {
  width: 36px;
  height: 36px;
  margin-right: 12px;
  flex-shrink: 0;
}
.gift-icon {
  width: 36px;
  height: 36px;
  line-height: 36px;
  text-align: center;
  margin-right: 12px;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2px solid #FFFFFF;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: bold;
}
.ledger-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.ledger-name {
  font-size: 16px;
  font-weight: bold;
  color: #333333;
}
.ledger-date {
  font-size: 12px;
  color: #666666;
  margin-top: 2px;
}
.ledger-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}
.ledger-count {
  font-size: 12px;
  color: #666666;
}
.ledger-amount {
  font-size: 16px;
  font-weight: bold;
  color: #333333;
  margin-top: 2px;
}
.wanglai-row {
  display: flex;
  gap: 12px;
  padding: 0 16px;
}
.wanglai-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 8px;
  border-radius: 12px;
}
.wanglai-gift {
  background: linear-gradient(135deg, #FFC7C3, #F78C8F);
}
.wanglai-receive {
  background: linear-gradient(135deg, #FFE4B8, #FDBE68);
}
.wanglai-name {
  font-size: 14px;
  color: #FFFFFF;
}
.wanglai-amount {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
  margin: 6px 0;
}
.wanglai-count {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.9);
}
.diff-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 12px 16px 0;
  padding: 12px;
  border-radius: 12px;
  background: #FFF8E1;
}
.diff-total {
  font-size: 13px;
  color: #999999;
}
.diff-val {
  font-size: 16px;
  font-weight: bold;
  color: #F0575A;
  margin-top: 4px;
}
.link-bar {
  margin: 20px 16px;
  padding: 12px;
  border-radius: 12px;
  background: #F0575A;
  color: #FFFFFF;
  font-size: 15px;
  text-align: center;
}
