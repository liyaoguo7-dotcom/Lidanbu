<!-- 亲友录 -->
<view class="tip"><text>📢</text><text style="margin-left:6px">{{tipText}}</text></view>

<view class="searchbar">
  <view class="searchbox">
    <input placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput"
      placeholder-style="color:#C2C2C2" style="flex:1;font-size:14px" />
  </view>
  <text class="search-cancel" bindtap="onCancelSearch">取消</text>
</view>

<view class="card">
  <block wx:for="{{groups}}" wx:key="key">
    <view class="group-title">{{item.key}}</view>
    <view class="contact-row" wx:for="{{item.items}}" wx:key="_id"
      data-id="{{item._id}}" data-name="{{item.name}}" bindtap="openSheet">
      <text class="nm">{{item.name}}</text>
      <text class="rmk" wx:if="{{item.remark}}">{{item.remark}}</text>
    </view>
  </block>
  <view class="contact-row" wx:if="{{groups.length === 0}}">
    <text class="ph">还没有亲友，点击下方红色＋添加</text>
  </view>
</view>

<view class="fab" bindtap="goAdd">＋</view>

<!-- 半屏详情 -->
<view class="sheet-mask" wx:if="{{sheetOpen}}" bindtap="closeSheet"></view>
<view class="sheet" wx:if="{{sheetOpen}}">
  <view class="sname songti">{{sheetName}}</view>
  <view class="sopt red" bindtap="goWanglai">往来记录</view>
  <view class="sopt" bindtap="goEdit">修改姓名</view>
  <view class="sopt" bindtap="onDelete">删除姓名<text class="sub">数据无价谨慎删除</text></view>
  <view class="sopt cancel" bindtap="closeSheet">取消</view>
</view>

<!-- 删除二次确认 -->
<view class="mask" wx:if="{{delModal}}"></view>
<view class="dialog" wx:if="{{delModal}}">
  <view class="dinfo">
    <text>联系人：<text class="b">{{delInfo.name}}</text>\n</text>
    <text>将同时删除 {{delInfo.receiveCount}} 条收礼、{{delInfo.giftCount}} 条送礼记录\n</text>
  </view>
  <view class="dwarn">删除后无法恢复，确定要删除吗？</view>
  <view class="dbtns">
    <view class="dcancel" bindtap="onCancelDel">取消</view>
    <view class="ddel" bindtap="onConfirmDel">删除</view>
  </view>
</view>
