<!-- 亲友录 -->
<view class="tip horn-blink" wx:if="{{!hornOff}}"><image class="tip-icon" src="/images/icons/speaker.svg" mode="aspectFit" /><scroll-view wx:if="{{hornWide}}" class="tip-scroll" scroll-x="true" bindtap="onHornTextTap"><text class="tip-txt-nowrap">{{tipText}}</text></scroll-view><view wx:else class="tip-body" bindtap="onHornTextTap"><text class="tip-txt-ellipsis">{{tipText}}</text></view><text class="tip-close" catchtap="onHornClose">×</text></view>

<view class="searchbar">
  <view class="searchbox">
    <input placeholder="搜索姓名" value="{{keyword}}" bindinput="onSearchInput"
      placeholder-style="color:#C2C2C2" style="flex:1;font-size:14px" />
  </view>
  <text class="search-cancel" bindtap="onCancelSearch">取消</text>
</view>

<view class="card">
  <block wx:for="{{groups}}" wx:key="key">
    <view class="group-title songti">{{item.key}}</view>
    <view class="contact-row" wx:for="{{item.items}}" wx:key="_id"
      data-id="{{item._id}}" data-name="{{item.name}}" bindtap="openSheet">
      <text class="nm">{{item.name}}</text>
      <text class="rmk" wx:if="{{item.remark}}">{{item.remark}}</text>
    </view>
  </block>
  <view class="contact-row" wx:if="{{groups.length === 0}}">
    <text class="ph">还没有亲友，点击下方红色＋添加</text>
  </view>
</view>

<view class="fab" bindtap="goAdd">＋</view>

<!-- 半屏详情 -->
<view class="sheet-mask" wx:if="{{sheetOpen}}" bindtap="closeSheet"></view>
<view class="sheet" wx:if="{{sheetOpen}}">
  <view class="sname songti">{{sheetName}}</view>
  <view class="sopt red" bindtap="goWanglai">往来记录</view>
  <view class="sopt" bindtap="goEdit">修改姓名</view>
  <view class="sopt" bindtap="onDelete">删除姓名</view>
  <view class="snote">数据无价，谨慎删除</view>
  <view class="sopt cancel" bindtap="closeSheet">取消</view>
</view>

<!-- 删除二次确认（全产品统一弹窗） -->
<confirm-modal show="{{delModal}}" title="删除亲友" content="{{delContent}}"
  bind:confirm="onConfirmDel" bind:cancel="onCancelDel" />

<!-- 添加亲友半屏 -->
<contact-sheet show="{{addSheetOpen}}"
  bind:confirm="onAddConfirm" bind:cancel="onAddCancel" />

<!-- 修改亲友信息半屏 -->
<contact-edit-sheet show="{{editSheetOpen}}" initName="{{editName}}" initRemark="{{editRemark}}"
  bind:confirm="onEditConfirm" bind:cancel="onEditCancel" />
