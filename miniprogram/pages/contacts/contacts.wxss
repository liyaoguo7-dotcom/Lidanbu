/* 亲友录 */
.group-title {
  padding: 6px 16px 2px;
  font-size: 12px;
  color: #C2C2C2;
  background: #F6F6F6;
}
.contact-row {
  display: flex;
  align-items: center;
  padding: 0 16px;
  min-height: 50px;
  border-bottom: 1px solid #F0F0F0;
}
.contact-row:last-child { border-bottom: none; }
.nm { font-size: 16px; }
.rmk { font-size: 13px; color: #C2C2C2; margin-left: 8px; }
.ph { color: #C2C2C2; font-size: 14px; }
/* 半屏 */
.sheet-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.35); z-index: 20;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 16px 16px 0 0;
  z-index: 21; padding-bottom: 20px; padding-bottom: calc(20px + env(safe-area-inset-bottom));
}
.sname { text-align: center; font-size: 17px; font-weight: 600; padding: 18px 0 6px; }
.sopt { text-align: center; height: 58px; line-height: 58px; font-size: 15px; border-top: 2px solid #F4F4F4; }
.sopt.red { color: #F0575A; }
.sopt.cancel { color: #999; }
.snote {
  text-align: center; font-size: 12px; color: #C2C2C2;
  padding: 8px 0 2px;
}
/* （删除弹窗已改走全产品统一的 confirm-modal 组件，样式见组件） */

/* 加号下移（2026-10-23 任务AC 第 6 项）：三页 .fab 的 bottom 本来就都是 64px（无页面级覆盖），
   亲友录看着更高是因为它是 Tab 页——webview 底边在原生 tabBar（内容高 50px）之上，
   同一个 64px 相对屏幕底就多出约一栏高。本页把 bottom 改为 14px：距屏幕底
   = 14 + 50（原生栏） + 安全区 = 64 + 安全区，与送礼/收礼页（非 Tab 页，64px 相对屏幕底）
   视觉位置一致。这里不用 env()：Tab 页 webview 不延伸进安全区，写死 14px 才确定。 */
.fab { bottom: 14px; }
