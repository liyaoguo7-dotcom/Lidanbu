/* 亲友录 */
/* CD批（用户定：颜色太多看着不舒服）：字母行六色循环取消，全换成图中浅蓝（L 组那个蓝）；卡片裁溢出防首行圆角外露 */
.card { overflow: hidden; margin: 10px 0; border-radius: 0; } /* CY批：通铺，卡片左右边距归零、圆角改直角（上下 10px 不动） */
/* CK批（用户 2026-10-29 定）＋CK修正（用户同日纠正：是上下太宽不是
   左右宽）：字母行浅蓝改淡黄再透明一点（rgba 0.6）；上下收窄（内边距
   6px/2px 改 2px/1px）；左右长度不动，全部换圆角。
   CL批（用户同日定）：联系人整体向左移、左边只留 2px（字母行与联系人
   行左内边距 16px 改 2px），右边给 A-Z 字母索引行腾位置；索引行不动 */
/* CY批（用户 2026-10-29 定）：CV 的收短一半是错的——恢复通长（去 margin-right），
   米色改暗灰 #666666、字母改白色；亲友录通铺（卡片与行左右边距归零、圆角改直角）；
   提示条＋搜索框置顶固定（sticky 包层，不改两者本身的内外边距；搜索框与提示条不贴边） */
.fixed-head { position: sticky; top: 0; z-index: 10; background: #F6F6F6; }
.group-title {
  border-radius: 0;
  padding: 2px 0 1px 0;
  font-size: 12px;
  color: #fff;
  background: #666666;
}
.group-title.c0 { background: #666666; }
.group-title.c1 { background: #666666; }
.group-title.c2 { background: #666666; }
.group-title.c3 { background: #666666; }
.group-title.c4 { background: #666666; }
.group-title.c5 { background: #666666; }
.contact-row {
  display: flex;
  align-items: center;
  padding: 0; /* CY批：通铺，左右内边距归零 */
  min-height: 50px;
  border-bottom: 1px solid #F0F0F0;
}
.contact-row:last-child { border-bottom: none; }
.nm { font-size: 17px; }
.rmk { font-size: 13px; color: #C2C2C2; margin-left: 8px; }
.ph { color: #C2C2C2; font-size: 14px; }
/* 半屏 */
.sheet-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.35); z-index: 20;
}
/* CW批（用户 2026-10-29 定）：弹窗字体大一档、全部居中——选项 15px 改
   17px（＝原姓名大小），姓名 17px 改 19px（比选项大一档）；删除栏把提示
   小字收进同一栏、整栏仍 58px；取消改红底白字胶囊按钮；弹窗底部多垫的
   20px 留白去掉、只留安全区，取消那截不再比其他行高 */
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 16px 16px 0 0;
  z-index: 21; padding-bottom: 0; padding-bottom: env(safe-area-inset-bottom);
}
.sname { text-align: center; font-size: 19px; font-weight: 600; padding: 18px 0 6px; }
.sopt { text-align: center; height: 58px; line-height: 58px; font-size: 17px; border-top: 2px solid #F4F4F4; }
.sopt.red { color: #F0575A; }
.sopt.del { display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: normal; }
.del-text { font-size: 17px; }
.del-note { font-size: 12px; color: #C2C2C2; margin-top: 2px; }
.sopt.cancel { display: flex; align-items: center; justify-content: center; line-height: normal; }
.cancel-btn { flex: 1; margin: 0 32px; height: 44px; line-height: 44px; text-align: center; font-size: 17px; color: #fff; background: #F0575A; border-radius: 22px; }
/* （删除弹窗已改走全产品统一的 confirm-modal 组件，样式见组件） */

/* 加号下移（2026-10-23 任务AC 第 6 项）：三页 .fab 的 bottom 本来就都是 64px（无页面级覆盖），
   亲友录看着更高是因为它是 Tab 页——webview 底边在原生 tabBar（内容高 50px）之上，
   同一个 64px 相对屏幕底就多出约一栏高。本页把 bottom 改为 14px：距屏幕底
   = 14 + 50（原生栏） + 安全区 = 64 + 安全区，与送礼/收礼页（非 Tab 页，64px 相对屏幕底）
   视觉位置一致。这里不用 env()：Tab 页 webview 不延伸进安全区，写死 14px 才确定。 */
.fab { bottom: 14px; }

/* 右侧字母快选栏（2026-10-24 用户定） */
.index-bar {
  position: fixed; right: 4px; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; align-items: center;
  padding: 6px 0; z-index: 60;
}
.idx-item {
  width: 16px; height: 16px; line-height: 16px; text-align: center;
  font-size: 10px; color: #8A8A8A; border-radius: 50%;
}
.idx-item.off { color: #D8D8D8; }
.idx-item.on { background: #F0575A; color: #FFF; font-weight: 700; }
.idx-bubble {
  position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 64px; height: 64px; line-height: 64px; text-align: center;
  font-size: 34px; color: #FFF; background: rgba(0, 0, 0, .55);
  border-radius: 12px; z-index: 200;
}
