/* 送礼详情 */
.pat-card { text-align: center; padding: 24px 0 14px; }
.pat-big {
  width: 72px; height: 72px; border-radius: 50%;
  background: #F1E6D3;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
}
.pat-big.baishi { background: #E8EAED; }
.pat-img { width: 52px; height: 52px; }
.pat-name { font-size: 14px; color: #E05353; font-weight: 700; margin-top: 8px; display: block; }
.pat-name.baishi { color: #3B4046; }
.strong { font-weight: 600; }
.wanglai-link {
  text-align: center;
  margin-top: 20px;
  color: #F0575A;
  font-size: 15px;
}
/* 底部双大按钮：左删除（描边）右修改（主按钮） */
.bottom-btns {
  position: fixed;
  left: 24px;
  right: 24px;
  bottom: 26px;
  display: flex;
  gap: 12px;
}
.btn-outline {
  flex: 1;
  height: 56px;
  line-height: 54px;
  background: #fff;
  color: #F0575A;
  border: 1px solid #F0575A;
  text-align: center;
  font-size: 17px;
  border-radius: 28px;
}
.btn-half {
  flex: 1;
  position: static;
  left: auto;
  right: auto;
  bottom: auto;
}
/* （删除弹窗已改走全产品统一的 confirm-modal 组件，样式见组件） */
