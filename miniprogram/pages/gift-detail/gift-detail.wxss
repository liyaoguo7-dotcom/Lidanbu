/* 送礼详情 */
.pat-card { text-align: center; padding: 24px 0 14px; }
.pat-big {
  width: 72px; height: 72px; border-radius: 50%;
  background: #F1E6D3;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
}
.pat-big.baishi { background: #E8EAED; }
.pat-img { width: 52px; height: 52px; }
.pat-name { font-size: 14px; color: #E05353; font-weight: 700; margin-top: 8px; display: block; }
.pat-name.baishi { color: #3B4046; }
.strong { font-weight: 600; }
.wanglai-link {
  text-align: center;
  margin-top: 20px;
  color: #F0575A;
  font-size: 15px;
}
.del-link {
  position: fixed;
  left: 0; right: 0;
  bottom: 96px;
  text-align: center;
  color: #F0575A;
  font-size: 15px;
}
/* 统一删除弹窗（半透明遮罩 + 居中） */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45); z-index: 20;
}
.dialog {
  position: fixed; left: 50%; top: 38%;
  transform: translate(-50%,-50%);
  width: 300px; background: #fff; border-radius: 12px;
  z-index: 21; overflow: hidden;
}
.dinfo { padding: 20px 20px 6px; font-size: 14px; color: #555; line-height: 1.9; }
.dinfo .b { color: #333; font-weight: 600; }
.dwarn { text-align: center; font-size: 14px; color: #333; padding: 10px 20px 16px; font-weight: 500; }
.dbtns { display: flex; border-top: 1px solid #F0F0F0; }
.dcancel, .ddel { flex: 1; text-align: center; padding: 14px 0; font-size: 15px; }
.dcancel { color: #666; border-right: 1px solid #F0F0F0; }
.ddel { color: #F0575A; font-weight: 600; }
