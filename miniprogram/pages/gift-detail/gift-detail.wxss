/* 送礼详情（任务Z 第 11 项目标图版式；与收礼详情同构，dt- 样式两页各一份保持独立） */
.dt-card { padding: 22px 20px 12px; }
.dt-head { display: flex; align-items: center; justify-content: center; }
.dt-badge {
  width: 42px; height: 42px; border-radius: 50%; background: #F0575A;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.dt-badge.baishi { background: #E8EAED; }
.dt-badge-img { width: 30px; height: 30px; }
.dt-tagname { font-size: 16px; color: #333; margin-left: 10px; }
.dt-tagname.baishi { color: #3B4046; }
.dt-amount {
  text-align: center; font-size: 44px; font-weight: 600; color: #1A1A1A;
  margin: 18px 0 20px; letter-spacing: .5px;
}
/* 信息行：第 13 项口径——左标签浅灰 #999、右内容深 #333 */
.dt-row { display: flex; align-items: baseline; padding: 7px 0; }
.dt-label { width: 56px; flex: none; font-size: 15px; color: #999999; }
.dt-val { flex: 1; font-size: 15px; color: #333333; }
.dt-val.ph { color: #333333; }
/* 卡内操作行：分隔线下左右两半，中间竖线 */
.dt-actions { display: flex; align-items: stretch; border-top: 1px solid #F0EDE6; margin-top: 12px; padding-top: 4px; }
.dt-act { flex: 1; display: flex; align-items: center; justify-content: center; padding: 12px 0 6px; }
.dt-act-icon { width: 20px; height: 20px; }
.dt-act-text { font-size: 16px; color: #333; margin-left: 8px; }
.dt-vline { width: 1px; background: #F0EDE6; margin: 8px 0 2px; }
.wanglai-link {
  text-align: center;
  margin-top: 22px;
  color: #F0575A;
  font-size: 16px;
}
/* （删除弹窗已改走全产品统一的 confirm-modal 组件，样式见组件） */
