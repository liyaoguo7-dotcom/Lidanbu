/* 礼单簿 · 全局样式（界面风格规范 v1，对应 docs/wireframes/batch1/src/style-vars.css） */
page {
  background: #F6F6F6;
  color: #333333;
  font-size: 15px;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}
.card {
  background: #FFFFFF;
  border-radius: 12px;
  margin: 12px;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 0 16px;
  min-height: 58px;
  border-bottom: 1px solid #F0F0F0;
}
.form-row:last-child { border-bottom: none; }
.form-label { width: 82px; flex: none; }
.form-val { flex: 1; }
.form-val.ph { color: #C2C2C2; }
.chev { color: #C2C2C2; font-size: 18px; }
.btn-primary {
  display: block;
  height: 56px;
  line-height: 56px;
  background: #F0575A;
  color: #fff;
  text-align: center;
  font-size: 17px;
  border-radius: 28px;
  margin: 0 24px;
}
.btn-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 26px;
}
.fab {
  position: fixed;
  bottom: 88px;
  left: 50%;
  margin-left: -29px;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #F0575A;
  color: #fff;
  font-size: 34px;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 10px rgba(240,87,90,.45);
  z-index: 5;
}
.songti { font-family: "Songti SC", "STSong", serif; }
.tip {
  display: flex;
  align-items: flex-start;
  padding: 8px 14px;
  font-size: 12px;
  color: #999;
  line-height: 1.6;
}
.searchbar { display: flex; align-items: center; padding: 10px 12px; }
.searchbox {
  flex: 1;
  background: #F2F2F2;
  border-radius: 17px;
  height: 34px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  color: #C2C2C2;
  font-size: 14px;
}
.search-cancel { color: #F0575A; font-size: 14px; margin-left: 8px; white-space: nowrap; }
.divider { height: 1px; background: #F0F0F0; }
