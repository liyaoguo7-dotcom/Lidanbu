/* 礼单簿 · 全局样式（界面风格规范 v1，对应 docs/wireframes/batch1/src/style-vars.css） */
page {
  background: #F6F6F6;
  color: #333333;
  font-size: 15px;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}
.card {
  background: #FFFFFF;
  border-radius: 12px;
  margin: 10px 12px;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 0 16px;
  min-height: 58px;
  border-bottom: 1px solid #F0F0F0;
}
.form-row:last-child { border-bottom: none; }
.form-label { width: 82px; flex: none; font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "SimSun", serif; }
.form-val { flex: 1; }
.form-val.ph { color: #C2C2C2; }
.chev { color: #C2C2C2; font-size: 18px; }
.btn-primary {
  display: block;
  height: 56px;
  line-height: 56px;
  background: #F0575A;
  color: #fff;
  text-align: center;
  font-size: 17px;
  border-radius: 28px;
  margin: 0 24px;
}
.btn-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 26px;
  bottom: calc(26px + env(safe-area-inset-bottom));
}
/* 红色＋位置全局只保留两种高度（2026-10-22 用户真机反馈：统一一个位置、向下）：
   - Tab 页（如亲友录）：70px = Tab 栏上方约 20px，与非 Tab 页贴底观感一致；
   - 非 Tab 列表页（.fab-low）：24px 贴底。
   注意 .fab-low 必须写在 .fab 之后才能覆盖 bottom。 */
.fab {
  position: fixed;
  bottom: 70px;
  bottom: calc(70px + env(safe-area-inset-bottom));
  left: 50%;
  margin-left: -29px;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #F0575A;
  color: #fff;
  font-size: 34px;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 10px rgba(240,87,90,.45);
  z-index: 5;
}
/* 非 Tab 列表页贴底版 ＋：24px（必须在 .fab 之后定义以覆盖其 bottom） */
.fab-low { bottom: 24px; bottom: calc(24px + env(safe-area-inset-bottom)); }
/* 字体规范 v1.1（用户 2026-10-18 确认）：标题/文字标签→宋体风格；金额/日期→黑体（系统无衬线）。不引入外部字体 */
.songti { font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "SimSun", serif; }
.num { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; }
.tip {
  display: flex;
  align-items: flex-start;
  padding: 8px 14px;
  font-size: 12px;
  color: #999;
  line-height: 1.6;
}
.tip-icon {
  width: 14px;
  height: 14px;
  flex: none;
  margin-top: 2px; /* 与小字行高对齐 */
}
/* 小喇叭统一规格（2026-10-22 用户定版）：不滚动、慢速柔和闪烁（opacity 1↔0.6、2.6s）；
   文字过长默认单行省略，点文字后左右滑动看全文；右侧 × 关闭后本次打开期间不再显示
   （状态在 services/horn-state.js 只存内存，禁止落 storage） */
@keyframes hornBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}
.horn-blink { animation: hornBlink 2.6s ease-in-out infinite; }
.tip-body { flex: 1; min-width: 0; margin-left: 6px; }
.tip-txt-ellipsis { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tip-scroll { flex: 1; min-width: 0; margin-left: 6px; white-space: nowrap; }
.tip-txt-nowrap { white-space: nowrap; }
.tip-close { flex: none; color: #C2C2C2; font-size: 16px; line-height: 1; padding: 1px 2px 0 10px; }
.searchbar { display: flex; align-items: center; padding: 10px 12px; }
.searchbox {
  flex: 1;
  background: #F2F2F2;
  border-radius: 17px;
  height: 34px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  color: #C2C2C2;
  font-size: 14px;
}
.search-cancel { color: #F0575A; font-size: 14px; margin-left: 8px; white-space: nowrap; }
.divider { height: 1px; background: #F0F0F0; }
.section-title { padding: 4px 12px 0; font-size: 13px; color: #999; font-family: "Songti SC", "STSong", "Noto Serif CJK SC", "SimSun", serif; }
.switch {
  width: 46px; height: 26px; border-radius: 13px;
  background: #DDD; position: relative; flex: none;
  transition: background .2s;
}
.switch.on { background: #F0575A; }
.switch .dot {
  width: 22px; height: 22px; border-radius: 50%;
  background: #fff; position: absolute; top: 2px; left: 2px;
  transition: left .2s;
}
.switch.on .dot { left: 22px; }
.check {
  width: 22px; height: 22px; border-radius: 50%;
  border: 1px solid #DDD; color: #fff; font-size: 14px;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.check.on { background: #F0575A; border-color: #F0575A; }
.btn-danger-outline {
  display: block; height: 56px; line-height: 54px;
  border: 1px solid #F0575A; color: #F0575A;
  text-align: center; font-size: 17px; border-radius: 28px;
  margin: 0 24px; background: #fff;
}
.warn-banner {
  margin: 12px; padding: 10px 14px; font-size: 12px; line-height: 1.6;
  background: #FFF8E6; border-radius: 12px; color: #8A6D1B;
}
.footer { text-align: center; font-size: 11px; color: #C2C2C2; padding: 18px 0 8px; }
.member-card {
  padding: 16px;
  background: linear-gradient(135deg, #F0575A, #e04447);
  border: none;
  display: flex; flex-direction: column;
}
.m-title { color: #fff; font-size: 16px; font-weight: 600; }
.m-desc { color: rgba(255,255,255,.85); font-size: 13px; margin-top: 8px; line-height: 1.7; }
.m-btn {
  margin-top: 12px; align-self: flex-start;
  background: #fff; color: #F0575A;
  font-size: 13px; font-weight: 600;
  padding: 8px 22px; border-radius: 20px;
}
.m-badge {
  margin-top: 12px; align-self: flex-start;
  border: 1px solid rgba(255,255,255,.7); color: #fff;
  font-size: 12px; padding: 6px 16px; border-radius: 16px;
}
