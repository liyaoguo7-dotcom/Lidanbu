/* 10 标签选择器（v3.1 13.4：两排每排5个，单选） */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx;
}

.tag {
  width: 20%; /* 每排 5 个 */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.tag-icon {
  font-size: 22rpx;
  color: #B0B0B0; /* 图案占位，视觉后定 */
  margin-bottom: 8rpx;
}

.tag-name {
  font-size: 28rpx;
  color: #333333;
}

.tag.active {
  background-color: #FFF0F0;
}

.tag.active .tag-name {
  color: #E64340;
  font-weight: bold;
}
