<!-- 居中确认弹窗：半透明遮罩 + 居中卡片，左取消右确认（确认默认红色） -->
<view class="mask" wx:if="{{show}}" bindtap="onCancel" catchtouchmove="noop">
  <view class="dialog" catchtap="noop">
    <view class="title">{{title}}</view>
    <view class="content">{{content}}</view>
    <view class="buttons">
      <view class="btn cancel-btn" bindtap="onCancel">{{cancelText}}</view>
      <view class="btn {{danger ? 'danger-btn' : 'primary-btn'}}" bindtap="onConfirm">{{confirmText}}</view>
    </view>
  </view>
</view>
