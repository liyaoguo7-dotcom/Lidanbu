<!-- 自定义 Tab 栏：与原生 tabBar 同款（图标 25px、文字 10px、未选 #404040、含安全区） -->
<view class="tabbar">
  <view wx:for="{{items}}" wx:key="pagePath" class="tabbar-item" data-path="{{item.pagePath}}" bindtap="onTap">
    <image class="tabbar-icon" src="{{item.icon}}" mode="aspectFit" />
    <text class="tabbar-text" style="color:{{selected === index ? '#F0575A' : '#404040'}}">{{item.text}}</text>
  </view>
</view>
