/* 小喇叭提示条（统一规格 2026-10-22 任务AB 第 8 项：淡黄底、常驻不闪烁；组件样式隔离，
   长文字慢速左滚的轨道/动画在本文件内同名定义一份——约 30px/秒、双份文字无缝循环） */
.tip-bar {
  display: flex;
  align-items: center;
  background: #FFF8E1;
  padding: 20rpx 24rpx;
}

.horn {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex: none;
}

.text {
  font-size: 28rpx;
  color: #E8912D;
}

.horn-marquee { flex: 1; min-width: 0; overflow: hidden; }
.horn-track { display: inline-flex; white-space: nowrap; will-change: transform; }
.horn-track.run { animation: hornScroll linear infinite; }
.horn-cell { padding-right: 48px; }
@keyframes hornScroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.ellipsis { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nowrap { white-space: nowrap; }

.close {
  flex: none;
  color: #E8912D;
  font-size: 40rpx;
  line-height: 1;
  padding: 0 4rpx 0 16rpx;
}
