/* 小喇叭提示条（统一规格 2026-10-22 任务AA 最终定版：淡黄底、硬闪；组件样式隔离，
   动画在本文件内同名定义一份——关键帧阶跃跳变，周期 3s、显隐各半） */
@keyframes hornBlink {
  0% { opacity: 1; }
  49% { opacity: 1; }
  50% { opacity: 0; }
  99% { opacity: 0; }
  100% { opacity: 1; }
}
.tip-bar.horn-blink { animation: hornBlink 3s linear infinite; }
.tip-bar {
  display: flex;
  align-items: center;
  background: #FFF8E1;
  padding: 12rpx 24rpx;
}

.horn {
  width: 24rpx; /* 很小的小喇叭 */
  height: 24rpx;
  margin-right: 8rpx;
  flex: none;
}

.text {
  font-size: 24rpx; /* 动态小字 */
  color: #999999;
}

.text-body { flex: 1; min-width: 0; }
.ellipsis { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.text-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.nowrap { white-space: nowrap; }

.close {
  flex: none;
  color: #C2C2C2;
  font-size: 30rpx;
  line-height: 1;
  padding: 0 4rpx 0 16rpx;
}
