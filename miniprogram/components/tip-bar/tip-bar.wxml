<!-- 小喇叭提示条：小喇叭 + 文字（放不下慢速左滚），常驻不闪烁，× 关闭仅本次 -->
<view class="tip-bar" wx:if="{{text && !hidden}}">
  <image class="horn" src="/images/icons/speaker.svg" mode="aspectFit" />
  <view class="horn-marquee">
    <view wx:if="{{hornRun}}" class="horn-track run" style="animation-duration:{{hornDur}}s">
      <text class="text nowrap horn-cell">{{text}}</text>
      <text class="text nowrap horn-cell">{{text}}</text>
    </view>
    <text wx:else class="text ellipsis">{{text}}</text>
  </view>
  <text class="close" catchtap="onClose">×</text>
</view>
