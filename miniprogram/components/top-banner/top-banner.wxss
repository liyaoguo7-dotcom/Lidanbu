/* 顶部条形弹窗（BA批按竞品视频复刻）：白色胶囊条贴标题行。左缘距屏左
   12px 固定，右缘与纵向位置由 JS 按胶囊实测写入（右缘在胶囊左缘外 8px
   止步、纵向与胶囊同行居中）；高 32px 约等于胶囊高。动画：以右缘为原点
   横向展开（scaleX 0→1＋淡入，约 300ms），收起同理。组件样式隔离。 */
.top-banner {
  position: fixed;
  left: 12px;
  height: 32px;
  transform-origin: right center;
  transform: scaleX(0);
  opacity: 0;
  transition: transform .3s ease, opacity .3s ease;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 999px;
  padding: 0 12px 0 4px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, .16);
  z-index: 50;
  box-sizing: border-box;
}
.top-banner.in {
  transform: scaleX(1);
  opacity: 1;
}
.tb-logo {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  flex: none;
}
.tb-text {
  font-size: 13px;
  color: #333;
  margin-left: 7px;
  white-space: nowrap;
  overflow: hidden;
}
